---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import { services, phases, serviceFaq } from '../../i18n/services';
import '../../styles/english.css';
interface Props { kind: string }
const { kind } = Astro.props;
const service = services.find(s=>s.slug===kind);
const pricing = kind==='pricing'; const process = kind==='how-we-work';
const title=service?.title ?? (pricing?'Pricing':process?'How we work':'AI automation services');
const headline=service?.headline ?? (pricing?'A clear scope. A sensible first investment.':process?'From repetitive task to reliable workflow.':'Your team has better things to do.');
const description=service?.description ?? (pricing?'Understand the starting investment before we talk. The final proposal depends on your process, tools, data, and exceptions.':process?'We reduce uncertainty at every stage, with explicit responsibilities, real tests, and a system your team can understand.':'We design and implement AI automation for customer support, sales, and operations. Start with one process. Keep control as you grow.');
const faqs=pricing?[
 ['Are these fixed quotes?','No. These are indicative starting prices. Scope, integrations, data volume, access, risk, training, and support affect the final quote.'],
 ['Are software licenses included?','Only if the proposal explicitly includes them. Software licenses, APIs, messaging, and applicable VAT are detailed separately.'],
 ['Does the free assessment commit me to anything?','No. It helps you identify a useful priority and decide whether an implementation is appropriate.'],
 ['What does ongoing support cover?','Agreed incident handling, adjustments, and reviews of workflow measurements. The proposal defines the support scope.'],
]:serviceFaq;
const tracking={'data-track-event':'service_cta_click','data-track-page-type':service?'service_detail':pricing?'pricing':'services','data-track-service':service?.service??'general_consulting','data-track-cluster':service?.cluster??'general'};
---
<BaseLayout title={`${title} | AgentesVA`} description={description}>
<SiteHeader />
<main id="main-content" class="en-page" data-pagefind-body>
<section class="en-hero"><div class="en-shell"><nav class="en-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>{service&&<><a href="/services/">Services</a><span>/</span></>}<span aria-current="page">{title}</span></nav><div class="en-hero-grid"><div><p class="en-kicker">{title}</p><h1>{headline}</h1><p class="en-lead">{description}</p><div class="en-actions"><a class="en-button" href="/assessment/" {...tracking} data-track-placement="hero">Assess my process</a><a class="en-button en-button--quiet" href={pricing?'#compare':process?'#process':'#explore'}>{pricing?'Compare the options':process?'See the process':'Explore what we can build'}</a></div><p class="en-note">Free initial assessment · About 3 minutes</p></div><aside class="en-margin-note"><span class="en-node" aria-hidden="true">↳</span><h2>{pricing?'Start small. Know what comes next.':process?'Your team stays in control.':'A working system, with a human owner.'}</h2><p>{service?.limit??'We agree the boundaries, test the exceptions, and document the handover. No unexplained black box.'}</p></aside></div></div></section>
{pricing ? <section id="compare" class="en-section en-shell"><div class="en-section-heading"><h2>Choose the right starting point.</h2><p>Discovery, implementation, and support solve different problems. You do not need to buy everything at once.</p></div><p class="en-table-hint">On smaller screens, scroll the table to compare all options.</p><div class="en-table-scroll" tabindex="0" role="region" aria-label="Service comparison"><table class="en-comparison"><caption>Indicative starting prices in EUR. VAT and third-party costs are detailed separately.</caption><thead><tr><th scope="col">What you need</th><th scope="col">Scope workshop</th><th scope="col" class="highlight">First implementation</th><th scope="col">Several integrations</th></tr></thead><tbody><tr><th scope="row">Starting investment</th><td>€300</td><td class="highlight">€1,500</td><td>€3,000</td></tr><tr><th scope="row">Outcome</th><td>Process map and a clear scope</td><td class="highlight">One tested, working flow</td><td>Connected workflows across tools</td></tr><tr><th scope="row">Typical implementation time</th><td>Agreed in the proposal</td><td class="highlight">2–4 weeks</td><td>4–8 weeks</td></tr><tr><th scope="row">Testing & documentation</th><td>Scope and risk assessment</td><td class="highlight">Included in the agreed scope</td><td>Included in the agreed scope</td></tr><tr><th scope="row">Handover</th><td>Recommended plan</td><td class="highlight">Training and operating notes</td><td>Training and launch support</td></tr></tbody></table></div><div class="en-support"><h3>Support & optimization</h3><strong>From €300/month</strong><p>Keep active workflows useful with agreed maintenance, adjustments, and measurement reviews.</p></div></section>
: process ? <section id="process" class="en-section en-shell"><div class="en-section-heading"><h2>Six steps. Clear decisions.</h2><p>Each phase makes the next one easier to judge. If the process is not ready, we say so before building.</p></div><ol class="en-process">{phases.map(([name,text],i)=><li><span class="en-step">{i+1}</span><div><h3>{name}</h3><p>{text}</p></div></li>)}</ol><div class="en-split en-responsibilities"><article><h3>You bring the context.</h3><ul><li>A named internal owner.</li><li>Real examples and legitimate access.</li><li>Time to validate rules and test results.</li></ul></article><article><h3>We make the system understandable.</h3><ul><li>A scoped design with clear boundaries.</li><li>Tested workflows and exception handling.</li><li>Documentation, training, and a handover.</li></ul></article></div></section>
: service ? <><section id="explore" class="en-section en-shell"><div class="en-section-heading"><h2>What this looks like in practice.</h2><p>Use cases to scope around your process, tools, and team.</p></div><div class="en-use-cases">{service.examples.map(([name,text])=><article><h3>{name}</h3><p>{text}</p></article>)}</div></section><section class="en-section en-tinted"><div class="en-shell en-split"><div><h2>What you receive.</h2><ul class="en-checklist">{service.deliverables.map(item=><li>{item}</li>)}</ul></div><aside class="en-investment"><h3>One useful first workflow.</h3><strong>From €1,500</strong><p>Typically 2–4 weeks for a scoped implementation. Several integrations start at €3,000 and typically take 4–8 weeks.</p><a href="/pricing/">See scope and pricing</a><hr/><h3>Measure what changes.</h3><p>{service.measure}</p></aside></div></section></>
: <section id="explore" class="en-section en-shell"><div class="en-section-heading"><h2>Three places to start.</h2><p>Choose the part of the business where repetitive work creates the most friction.</p></div><div class="en-service-list">{services.map(s=><a href={`/services/${s.slug}/`} class="en-service-row" {...tracking} data-track-service={s.service} data-track-cluster={s.cluster} data-track-placement="service_card"><h3>{s.title}</h3><p>{s.description}</p><span aria-hidden="true">↗</span></a>)}</div><div class="en-support"><h3>A first implementation starts at €1,500.</h3><p>A free assessment helps identify your priority. A scope workshop starts at €300 when more definition is needed.</p><a href="/pricing/">Explore pricing and scope</a></div></section>}
<section class="en-section en-shell en-faq"><div><p class="en-kicker">Before you decide</p><h2>Good questions.<br/>Straight answers.</h2></div><div>{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
<section class="en-close"><div class="en-shell en-close-inner"><div><h2>What keeps repeating in your week?</h2><p>Start with the process. We will help you identify the next step.</p></div><a href="/assessment/" class="en-button en-button--white" {...tracking} data-track-placement="final_cta">Take the free assessment</a></div></section>
</main><SiteFooter hideNewsletter />
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebPage',name:title,description,inLanguage:'en',url:Astro.url.href.replace(Astro.url.origin,'https://agentesva.com')}).replace(/</g,'\\u003c')} />
</BaseLayout>
