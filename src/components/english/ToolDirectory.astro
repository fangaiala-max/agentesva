---
import PageSchema from '../shared/PageSchema.astro';
import {localeFor} from '../../i18n/routes';
import {ui,localizedPath} from '../../i18n/parity';
const locale=localeFor(Astro.url.pathname);
const t=(text:string)=>ui(locale,text);
const href=(url:string)=>localizedPath(locale,url);
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import translations from '../../i18n/tools.json';
import '../../styles/english.css';
import '../../styles/tool-showcase.css';
import ToolIdentity from './ToolIdentity.astro';
import ToolVisual from './ToolVisual.astro';
interface Props { category?: string }
const { category }=Astro.props;
const categoryNames:Record<string,string>={'Asistentes':'Assistants','Automatización':'Automation','Código':'Coding','Diseño':'Design','Escritura':'Writing','Marketing':'Marketing','Productividad':'Productivity','Vídeo':'Video','Video':'Video','Voz':'Voice','WhatsApp':'WhatsApp'};
const cats=await getCollection('categories');
const originalCat=cats.find(c=>c.id===category)?.data.nombre;
const all=(await getCollection('tools')).sort((a,b)=>a.data.orden-b.data.orden);
const tools=all.filter(item=>!originalCat||item.data.cat===originalCat);
const featured=['perplexity','claude','canva-ia'].flatMap(id=>tools.filter(item=>item.id===id));
const catName=(cat:string)=>locale==='es'?cat:(categoryNames[cat]??cat);
const copyFor=(tool:typeof all[number])=>locale==='en'?translations[tool.id as keyof typeof translations]:{description:tool.data.desc,features:tool.data.features,steps:tool.data.steps};
const label=originalCat?catName(originalCat):t("AI tools");
---
<BaseLayout title={`${label} | AgentesVA`} description={locale==='en'?'Explore AI tools by task and compare their uses.':'Explora herramientas de IA por tarea y compara sus usos.'}>
<PageSchema title={label} description={locale==='en'?'Explore tools by task':'Explora herramientas por tarea'} type="CollectionPage" items={tools.map(item=>({name:item.data.name,url:href(`/tools/${item.id}/`)}))}/><SiteHeader/><main id="main-content" class="en-page" data-pagefind-body><section class="en-hero"><div class="en-shell"><nav class="en-crumbs" aria-label={locale==='en'?'Breadcrumb':'Ruta de navegación'}><a href={href("/")}>{t("Home")}</a><span>/</span>{category&&<><a href={href("/tools/")}>{t("AI tools")}</a><span>/</span></>}<span aria-current="page">{label}</span></nav><div class="en-hero-grid"><div><p class="en-kicker">{t("The practical AI directory")}</p><h1>{category?`${label}${locale==='en'?', with a purpose.':', con un propósito.'}`:t("Find a tool for the task.")}</h1><p class="en-lead">{locale==='en'?`Explore ${tools.length} tools, understand their purpose, and follow a practical first step.`:`Explora ${tools.length} herramientas, comprende su utilidad y da un primer paso práctico.`}</p></div><aside class="en-margin-note"><h2>{t("Choose the workflow first.")}</h2><p>{t("A useful tool solves a specific problem. Try it with a representative task before making it part of your process.")}</p></aside></div></div></section>
{!category&&<section class="en-shell showcase-featured" aria-labelledby="featured-heading"><div class="showcase-heading"><div><p class="en-kicker">{t("The editorial selection")}</p><h2 id="featured-heading">{t("Three ways to move an idea forward.")}</h2></div><p>{t("Research it. Shape it. Make it visual.")}</p></div><div class="featured-deck" data-featured-deck>{featured.map((item,i)=><article class="featured-tool" data-active={i===0?'true':'false'}><button type="button" data-feature-toggle aria-expanded={i===0?'true':'false'} aria-controls={`feature-${item.id}`}><ToolIdentity slug={item.id} name={item.data.name}/><span>{locale==='es'?item.data.name:item.data.name.replace(/ IA$/, ' AI')}</span><span aria-hidden="true">+</span></button><div class="feature-teaser" aria-hidden="true"><div class:list={['teaser-preview',`teaser-${item.id}`]}>{item.id==='claude'?<div class="preview-document"><span class="preview-label">{t("A clearer draft")}</span><span class="preview-line wide"></span><span class="preview-line"></span><span class="preview-line wide"></span><span class="preview-highlight"></span><span class="preview-line short"></span></div>:item.id==='canva-ia'?<div class="preview-canvas"><div class="preview-poster"><span>{t("A new")}<br/>{t("perspective.")}</span><div class="poster-shape"></div></div><div class="preview-swatches"><i></i><i></i><i></i></div></div>:<div class="preview-document"><span class="preview-label">{t("Follow the evidence")}</span><span class="preview-line wide"></span><span class="preview-line"></span><span class="preview-source">{t("Source 01")}</span><span class="preview-source">{t("Source 02")}</span></div>}</div><div class="teaser-copy"><strong>{item.id==='perplexity'?t("Research with context"):item.id==='claude'?t("From brief to draft"):t("From idea to visual")}</strong><p>{item.id==='perplexity'?t("Explore answers and trace their sources."):item.id==='claude'?t("Shape your writing with your own source material."):t("Explore a design, then make it your own.")}</p></div><small>{t("Select the title to explore")}</small></div><div class="feature-content" id={`feature-${item.id}`}><ToolVisual slug={item.id} features={copyFor(item).features}/><p>{copyFor(item).description}</p><a href={href(`/tools/${item.id}/`)}>{t("Explore the tool")} <span aria-hidden="true">↗</span></a></div></article>)}</div><p class="showcase-caption">{t("Illustrative workflows, not product screenshots. Inclusion does not imply a commercial partnership.")}</p></section>}
<section class="en-section en-shell" data-catalog data-tool-showcase><div class="showcase-heading"><div><h2>{t("Your next useful tool.")}</h2><p>{t("Explore by task. Select two tools for a closer look.")}</p></div><a href="#partner">{t("Have a tool to share?")}</a></div><div class="en-catalog-tools"><label>{t("Search tools")}<input type="search" data-catalog-search placeholder={t("Try writing, meetings, or CRM")} autocomplete="off" /></label><label>{t("Filter by category")}<select data-catalog-filter><option value="">{t("All categories")}</option>{[...new Set(tools.map(item=>catName(item.data.cat)))].sort().map(c=><option value={c}>{c}</option>)}</select></label></div><p data-catalog-count role="status">{tools.length} {locale==='en'?'tools':'herramientas'}</p><div class="en-catalog-grid">{tools.map(item=>{const copy=copyFor(item);const cat=catName(item.data.cat);return <article class="en-resource-card showcase-card" data-catalog-item data-category={cat}><div class="tool-card-top"><ToolIdentity slug={item.id} name={item.data.name}/><span class="en-card-meta">{cat}</span></div><h3><a href={href(`/tools/${item.id}/`)}>{locale==='es'?item.data.name:item.data.name.replace(/ IA$/, ' AI')}</a></h3><p>{copy.description}</p><ul class="tool-capabilities">{copy.features.slice(0,2).map(f=><li>{f}</li>)}</ul><div class="tool-card-actions"><a href={href(`/tools/${item.id}/`)}>{t("View profile \u2197")}</a><button type="button" data-compare={item.id} aria-pressed="false" aria-label={`${locale==='en'?'Compare':'Comparar'} ${item.data.name}`}>{t("Compare +")}</button></div></article>})}</div><div class="en-empty" data-catalog-empty hidden><h2>{t("No tools match that search.")}</h2><p>{t("Try a broader task or choose another category.")}</p><button class="en-button" data-catalog-reset type="button">{t("Clear filters")}</button></div>
<div class="compare-tray" data-compare-tray hidden><p data-compare-status role="status"></p><div><button type="button" data-open-compare disabled>{t("Compare tools")}</button><button type="button" data-clear-compare>{t("Clear")}</button></div></div>
<dialog class="tool-compare-dialog" data-compare-dialog aria-labelledby="compare-title"><div class="showcase-heading"><h2 id="compare-title">{t("Find your fit.")}</h2><button type="button" data-close-compare aria-label={t("Close comparison")}>{t("Close \u00d7")}</button></div><p>{t("Compare the task and the first step. Check each provider for current pricing and limits.")}</p><div class="comparison-scroll" tabindex="0" role="region" aria-label={t("Tool comparison")}><table data-comparison-table></table></div></dialog>
<script type="application/json" data-comparison-data set:html={JSON.stringify(tools.map(item=>({id:item.id,name:locale==='es'?item.data.name:item.data.name.replace(/ IA$/, ' AI'),category:catName(item.data.cat),...copyFor(item),url:href(`/tools/${item.id}/`)}))).replace(/</g,'\\u003c')} />
</section><section class="tool-partner en-shell" id="partner"><div><p class="en-kicker">{t("For the people building the tools")}</p><h2>{t("Give your product")}<br/>{t("a practical context.")}</h2><p>{t("Show us the task your tool solves and a representative demo. We welcome tool submissions, corrections, and partnership enquiries.")}</p></div><div><a class="en-button" href={`mailto:hola@agentesva.com?subject=${encodeURIComponent(locale==='en'?'Tool submission — AgentesVA':'Propuesta de herramienta — AgentesVA')}`}>{t("Submit your tool")}</a><a class="partner-secondary" href={`mailto:hola@agentesva.com?subject=${encodeURIComponent(locale==='en'?'Tool partnership — AgentesVA':'Colaboración con herramientas — AgentesVA')}`}>{t("Discuss a partnership \u2197")}</a><p>{t("Submissions are reviewed for relevance. Commercial placements, when offered, are labeled separately from editorial content.")}</p></div></section></main><SiteFooter hideNewsletter />
</BaseLayout>
<script>import {initCatalog} from '../../scripts/catalog';import {initToolShowcase} from '../../scripts/tool-showcase';document.addEventListener('astro:page-load',()=>{initCatalog();initToolShowcase();});</script>
