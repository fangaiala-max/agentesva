---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import translations from '../../i18n/tools.json';
import '../../styles/english.css';
import '../../styles/tool-showcase.css';
import ToolIdentity from './ToolIdentity.astro';
import ToolVisual from './ToolVisual.astro';
interface Props { category?: string }
const { category }=Astro.props;
const categoryNames:Record<string,string>={'Asistentes':'Assistants','Automatización':'Automation','Código':'Coding','Diseño':'Design','Escritura':'Writing','Marketing':'Marketing','Productividad':'Productivity','Vídeo':'Video','Video':'Video','Voz':'Voice','WhatsApp':'WhatsApp'};
const cats=await getCollection('categories');
const originalCat=cats.find(c=>c.id===category)?.data.nombre;
const all=(await getCollection('tools')).sort((a,b)=>a.data.orden-b.data.orden);
const tools=all.filter(t=>!originalCat||t.data.cat===originalCat);
const featured=['perplexity','claude','canva-ia'].flatMap(id=>tools.filter(t=>t.id===id));
const label=originalCat?(categoryNames[originalCat]??originalCat):'AI tools';
---
<BaseLayout title={`${label}: practical tools for your business | AgentesVA`} description="Explore AI tools by task. Compare what they do, how to start, and where they could fit into your business workflow.">
<SiteHeader/><main id="main-content" class="en-page" data-pagefind-body><section class="en-hero"><div class="en-shell"><nav class="en-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>{category&&<><a href="/tools/">AI tools</a><span>/</span></>}<span aria-current="page">{label}</span></nav><div class="en-hero-grid"><div><p class="en-kicker">The practical AI directory</p><h1>{category?`${label}, with a purpose.`:'Find a tool for the task.'}</h1><p class="en-lead">Start with what you need to do. Explore {tools.length} tools, understand their purpose, and follow a practical first step.</p></div><aside class="en-margin-note"><h2>Choose the workflow first.</h2><p>A useful tool solves a specific problem. Try it with a representative task before making it part of your process.</p></aside></div></div></section>
{!category&&<section class="en-shell showcase-featured" aria-labelledby="featured-heading"><div class="showcase-heading"><div><p class="en-kicker">The editorial selection</p><h2 id="featured-heading">Three ways to move an idea forward.</h2></div><p>Research it. Shape it. Make it visual.</p></div><div class="featured-deck" data-featured-deck>{featured.map((t,i)=><article class="featured-tool" data-active={i===0?'true':'false'}><button type="button" data-feature-toggle aria-expanded={i===0?'true':'false'} aria-controls={`feature-${t.id}`}><ToolIdentity slug={t.id} name={t.data.name}/><span>{t.data.name.replace(/ IA$/, ' AI')}</span><span aria-hidden="true">+</span></button><div class="feature-teaser" aria-hidden="true"><div class:list={['teaser-preview',`teaser-${t.id}`]}>{t.id==='claude'?<div class="preview-document"><span class="preview-label">A clearer draft</span><span class="preview-line wide"></span><span class="preview-line"></span><span class="preview-line wide"></span><span class="preview-highlight"></span><span class="preview-line short"></span></div>:t.id==='canva-ia'?<div class="preview-canvas"><div class="preview-poster"><span>A new<br/>perspective.</span><div class="poster-shape"></div></div><div class="preview-swatches"><i></i><i></i><i></i></div></div>:<div class="preview-document"><span class="preview-label">Follow the evidence</span><span class="preview-line wide"></span><span class="preview-line"></span><span class="preview-source">Source 01</span><span class="preview-source">Source 02</span></div>}</div><div class="teaser-copy"><strong>{t.id==='perplexity'?'Research with context':t.id==='claude'?'From brief to draft':'From idea to visual'}</strong><p>{t.id==='perplexity'?'Explore answers and trace their sources.':t.id==='claude'?'Shape your writing with your own source material.':'Explore a design, then make it your own.'}</p></div><small>Select the title to explore</small></div><div class="feature-content" id={`feature-${t.id}`}><ToolVisual slug={t.id} features={translations[t.id as keyof typeof translations].features}/><p>{translations[t.id as keyof typeof translations].description}</p><a href={`/tools/${t.id}/`}>Explore the tool <span aria-hidden="true">↗</span></a></div></article>)}</div><p class="showcase-caption">Illustrative workflows, not product screenshots. Inclusion does not imply a commercial partnership.</p></section>}
<section class="en-section en-shell" data-catalog data-tool-showcase><div class="showcase-heading"><div><h2>Your next useful tool.</h2><p>Explore by task. Select two tools for a closer look.</p></div><a href="#partner">Have a tool to share?</a></div><div class="en-catalog-tools"><label>Search tools<input type="search" data-catalog-search placeholder="Try writing, meetings, or CRM" autocomplete="off" /></label><label>Filter by category<select data-catalog-filter><option value="">All categories</option>{[...new Set(tools.map(t=>categoryNames[t.data.cat]??t.data.cat))].sort().map(c=><option value={c}>{c}</option>)}</select></label></div><p data-catalog-count role="status">{tools.length} tools</p><div class="en-catalog-grid">{tools.map(t=>{const copy=translations[t.id as keyof typeof translations];const cat=categoryNames[t.data.cat]??t.data.cat;return <article class="en-resource-card showcase-card" data-catalog-item data-category={cat}><div class="tool-card-top"><ToolIdentity slug={t.id} name={t.data.name}/><span class="en-card-meta">{cat}</span></div><h3><a href={`/tools/${t.id}/`}>{t.data.name.replace(/ IA$/, ' AI')}</a></h3><p>{copy.description}</p><ul class="tool-capabilities">{copy.features.slice(0,2).map(f=><li>{f}</li>)}</ul><div class="tool-card-actions"><a href={`/tools/${t.id}/`}>View profile ↗</a><button type="button" data-compare={t.id} aria-pressed="false" aria-label={`Compare ${t.data.name}`}>Compare +</button></div></article>})}</div><div class="en-empty" data-catalog-empty hidden><h2>No tools match that search.</h2><p>Try a broader task or choose another category.</p><button class="en-button" data-catalog-reset type="button">Clear filters</button></div>
<div class="compare-tray" data-compare-tray hidden><p data-compare-status role="status"></p><div><button type="button" data-open-compare disabled>Compare tools</button><button type="button" data-clear-compare>Clear</button></div></div>
<dialog class="tool-compare-dialog" data-compare-dialog aria-labelledby="compare-title"><div class="showcase-heading"><h2 id="compare-title">Find your fit.</h2><button type="button" data-close-compare aria-label="Close comparison">Close ×</button></div><p>Compare the task and the first step. Check each provider for current pricing and limits.</p><div class="comparison-scroll" tabindex="0" role="region" aria-label="Tool comparison"><table data-comparison-table></table></div></dialog>
<script type="application/json" data-comparison-data set:html={JSON.stringify(tools.map(t=>({id:t.id,name:t.data.name.replace(/ IA$/, ' AI'),category:categoryNames[t.data.cat]??t.data.cat,...translations[t.id as keyof typeof translations]}))).replace(/</g,'\\u003c')} />
</section><section class="tool-partner en-shell" id="partner"><div><p class="en-kicker">For the people building the tools</p><h2>Give your product<br/>a practical context.</h2><p>Show us the task your tool solves and a representative demo. We welcome tool submissions, corrections, and partnership enquiries.</p></div><div><a class="en-button" href="mailto:hola@agentesva.com?subject=Tool%20submission%20%E2%80%94%20AgentesVA">Submit your tool</a><a class="partner-secondary" href="mailto:hola@agentesva.com?subject=Tool%20partnership%20%E2%80%94%20AgentesVA">Discuss a partnership ↗</a><p>Submissions are reviewed for relevance. Commercial placements, when offered, are labeled separately from editorial content.</p></div></section></main><SiteFooter hideNewsletter />
</BaseLayout>
<script>import {initCatalog} from '../../scripts/catalog';import {initToolShowcase} from '../../scripts/tool-showcase';document.addEventListener('astro:page-load',()=>{initCatalog();initToolShowcase();});</script>
