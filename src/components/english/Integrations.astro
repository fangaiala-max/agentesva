---
const rows = [
  [{ symbol: '◌', label: 'Messaging' }, { symbol: '↗', label: 'CRM' }, { symbol: '▤', label: 'Documents' }, { symbol: '▦', label: 'Spreadsheets' }],
  [{ symbol: '☷', label: 'Forms' }, { symbol: '✉', label: 'Email' }, { symbol: '◎', label: 'Human review' }, { symbol: '⌘', label: 'Workflows' }],
];
---
<section class="integration-section" aria-labelledby="integration-title" data-integrations data-paused="true">
  <div class="agency-shell integration-layout"><div><span class="section-number">Connect the tools you use</span><h2 id="integration-title">Your tools. Working together.</h2><p>We connect your channels, data, and team. Each integration is checked against the access, permissions, and scope of your project.</p><a href="/services/" class="text-link">Explore services <span aria-hidden="true">↗</span></a></div><div class="integration-visual"><div class="integration-rows">{rows.map((row, i) => <div class:list={['integration-track', { reverse: i === 1 }]}>{[0, 1].map((copy) => <ul aria-hidden={copy === 1 ? 'true' : undefined}>{row.map((item) => <li><span aria-hidden="true">{item.symbol}</span><strong>{item.label}</strong></li>)}</ul>)}</div>)}</div><div class="integration-caption"><span>System categories · connections depend on scope</span><button type="button" data-integrations-pause aria-pressed="false" disabled>Pause movement</button></div></div></div>
</section>
