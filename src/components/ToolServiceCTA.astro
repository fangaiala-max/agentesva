---
import type { Tool } from '../data/tools';
import { implementationCost, toolServiceRecommendation } from '../data/tool-service-cta';
interface Props { tool: Tool; placement?: 'hero' | 'contextual' }
const { tool, placement = 'contextual' } = Astro.props;
const recommendation = toolServiceRecommendation(tool);
---
<section class:list={['tool-service-cta', { 'tool-service-cta--compact': placement === 'hero' }]} aria-label={`Implementar ${tool.name} en tu empresa`}>
  <div>
    <span class="tool-service-cta__eyebrow">Implementación en empresa</span>
    <h2>{recommendation.title}</h2>
    <p>{recommendation.description}</p>
  </div>
  {placement === 'contextual' && <dl>
    <div><dt>Ejemplo</dt><dd>{recommendation.example}</dd></div>
    <div><dt>Coste aproximado</dt><dd>{implementationCost(tool.price)}</dd></div>
    <div><dt>Dificultad</dt><dd>{recommendation.difficulty}</dd></div>
    <div><dt>Compatible con</dt><dd>{recommendation.compatible}</dd></div>
  </dl>}
  <a href={recommendation.href} data-track-event="service_cta_click" data-track-page-type="tool_detail" data-track-content-slug={tool.slug} data-track-service={recommendation.service} data-track-cluster={recommendation.cluster} data-track-placement={placement === 'hero' ? 'tool_hero' : 'tool_contextual'}>{placement === 'hero' ? 'Ver implementación →' : 'Evaluar este caso →'}</a>
</section>
<style>
  .tool-service-cta{padding:24px;border:1px solid color-mix(in srgb,var(--accent) 48%,var(--line));border-radius:10px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 10%,var(--panel)),var(--panel));}.tool-service-cta__eyebrow{color:var(--accent);font:600 10px var(--mono);letter-spacing:.14em;text-transform:uppercase}.tool-service-cta h2{margin:8px 0 0;color:#fff;font:600 22px var(--sans)}.tool-service-cta p{margin:8px 0 0;color:var(--fg-2);line-height:1.6}.tool-service-cta dl{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin:20px 0;background:var(--line)}.tool-service-cta dl div{padding:14px;background:var(--panel-2)}.tool-service-cta dt{color:var(--fg-5);font:600 9px var(--mono);letter-spacing:.1em;text-transform:uppercase}.tool-service-cta dd{margin:6px 0 0;color:var(--fg-2);font-size:13px;line-height:1.45}.tool-service-cta a{display:inline-block;margin-top:18px;padding:12px 17px;border-radius:3px;background:var(--accent);color:var(--bg);font-weight:700;text-decoration:none}.tool-service-cta--compact{max-width:310px;padding:18px}.tool-service-cta--compact h2{font-size:17px}.tool-service-cta--compact p{font-size:13px}.tool-service-cta--compact a{width:100%;box-sizing:border-box;text-align:center}@media(max-width:600px){.tool-service-cta dl{grid-template-columns:1fr}}
</style>
