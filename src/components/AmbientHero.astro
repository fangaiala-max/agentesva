<div class="ambient-hero" aria-hidden="true">
  <span class="ambient-hero__orb ambient-hero__orb--one"></span><span class="ambient-hero__orb ambient-hero__orb--two"></span><span class="ambient-hero__grid"></span>
</div>
<style>.ambient-hero{position:absolute;inset:0;overflow:hidden;pointer-events:none;isolation:isolate}.ambient-hero__orb{position:absolute;border-radius:50%;filter:blur(4px);opacity:.42;will-change:transform}.ambient-hero__orb--one{top:-18rem;right:-10rem;width:38rem;height:38rem;background:radial-gradient(circle,rgba(91,124,255,.38),rgba(91,124,255,0) 68%);animation:ambient-float 14s ease-in-out infinite}.ambient-hero__orb--two{bottom:-22rem;left:-12rem;width:34rem;height:34rem;background:radial-gradient(circle,rgba(169,188,255,.2),rgba(169,188,255,0) 70%);animation:ambient-float 18s ease-in-out infinite reverse}.ambient-hero__grid{position:absolute;inset:0;background-image:linear-gradient(rgba(169,188,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(169,188,255,.045) 1px,transparent 1px);background-size:52px 52px;mask-image:linear-gradient(to bottom,black,transparent 88%)}@keyframes ambient-float{50%{transform:translate3d(-28px,22px,0) scale(1.08)}}@media(prefers-reduced-motion:reduce){.ambient-hero__orb{animation:none}}</style>
