// Visual reference: Meng To / ThreeUI — https://21st.dev/@mengto/components/particle-drift
// Native canvas implementation for AgentesVA; no iframe or React runtime.
---
<div class="particle-drift" aria-hidden="true">
  <canvas data-particle-drift></canvas>
</div>

<style>
  .particle-drift { position: absolute; inset: 0; z-index: -2; overflow: hidden; pointer-events: none; }
  canvas { display: block; width: 100%; height: 100%; }
</style>
