---
import type { CommercialLink } from '../data/commercial-links';
interface Props { links: readonly CommercialLink[]; title?: string; theme?: 'dark' | 'light'; pageType: string; slug: string }
const { links, title = 'Siguiente decisión', theme = 'dark', pageType, slug } = Astro.props;
---
{links.length > 0 && <section class:list={['commercial-next', `commercial-next--${theme}`]} data-pagefind-ignore>
  <span>Recursos relacionados</span><h2>{title}</h2><div class="commercial-next__grid">{links.map((link) => <a href={link.href} data-track-event="internal_cluster_click" data-track-page-type={pageType} data-track-content-slug={slug}><strong>{link.title}</strong><small>{link.description}</small><b>Leer →</b></a>)}</div>
</section>}
<style>
  .commercial-next{margin:48px auto;padding:32px;border:1px solid var(--line);border-radius:14px}.commercial-next>span{font:700 10px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}.commercial-next>h2{margin:8px 0 0;font:400 30px var(--serif)}.commercial-next__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}.commercial-next a{position:relative;display:flex;overflow:hidden;flex-direction:column;padding:20px;border:1px solid var(--line);border-radius:10px;text-decoration:none;transition:transform .3s,border-color .3s,box-shadow .3s}.commercial-next a::after{position:absolute;right:-22px;bottom:-28px;width:74px;height:74px;border-radius:50%;background:color-mix(in srgb,var(--accent) 12%,transparent);content:'';transition:transform .35s}.commercial-next a:hover{transform:translateY(-5px);border-color:color-mix(in srgb,var(--accent) 55%,var(--line));box-shadow:0 16px 38px rgba(10,26,51,.14)}.commercial-next a:hover::after{transform:scale(1.7)}.commercial-next a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.commercial-next strong,.commercial-next small,.commercial-next b{position:relative;z-index:1}.commercial-next strong{font-size:16px}.commercial-next small{flex:1;margin-top:7px;font-size:13px;line-height:1.5}.commercial-next b{margin-top:15px;color:var(--accent);font:700 11px var(--mono);text-transform:uppercase}.commercial-next--dark{background:var(--panel);color:#fff}.commercial-next--dark small{color:var(--fg-3)}.commercial-next--light{background:#fff;color:#17233b;border-color:#dce3ef}.commercial-next--light a{border-color:#dce3ef;color:#17233b}.commercial-next--light small{color:#59667d}@media(prefers-reduced-motion:reduce){.commercial-next a,.commercial-next a::after{transition:none}.commercial-next a:hover{transform:none}}@media(max-width:720px){.commercial-next__grid{grid-template-columns:1fr}}
</style>
