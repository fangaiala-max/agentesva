<div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
<style>.reading-progress{position:fixed;z-index:90;top:0;left:0;width:100%;height:3px;background:transparent;pointer-events:none}.reading-progress span{display:block;width:100%;height:100%;background:linear-gradient(90deg,var(--accent),#a9bcff);transform:scaleX(0);transform-origin:left;will-change:transform;box-shadow:0 0 12px rgba(91,124,255,.45)}@media(prefers-reduced-motion:reduce){.reading-progress{display:none}}</style>
<script>function initReadingProgress(){const bar=document.querySelector<HTMLElement>('[data-reading-progress]');if(!bar||bar.dataset.wired)return;bar.dataset.wired='1';let queued=false;const update=()=>{const max=document.documentElement.scrollHeight-innerHeight;bar.style.transform=`scaleX(${max>0?Math.min(1,scrollY/max):0})`;queued=false};addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(update)}},{passive:true});update()}document.addEventListener('astro:page-load',initReadingProgress);</script>
