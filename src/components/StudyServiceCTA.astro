---
import{studyServiceRecommendation}from'../data/study-service-cta';interface Props{slug:string;placement:'after_summary'|'final'}const{slug,placement}=Astro.props;const r=studyServiceRecommendation(slug);
---
<aside class="study-service"><span>Aplicación en tu empresa</span><h2>{r.title}</h2><p>{r.description}</p><a href={r.href} data-track-event="service_cta_click" data-track-page-type="study" data-track-content-slug={slug} data-track-service={r.service} data-track-cluster={r.cluster} data-track-placement={placement}>{placement==='after_summary'?'Ver cómo lo implementamos →':'Evaluar mi caso →'}</a></aside>
<style>.study-service{margin-top:28px;padding:24px;border:1px solid color-mix(in srgb,var(--accent) 45%,var(--line));border-radius:10px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 9%,var(--panel)),var(--panel))}.study-service span{color:var(--accent);font:600 10px var(--mono);letter-spacing:.14em;text-transform:uppercase}.study-service h2{margin:9px 0 0;color:#fff;font:600 21px var(--sans)}.study-service p{margin:9px 0 0;color:var(--fg-2);line-height:1.6}.study-service a{display:inline-block;margin-top:17px;padding:11px 16px;border-radius:3px;background:var(--accent);color:var(--bg);font-weight:700;text-decoration:none}</style>
