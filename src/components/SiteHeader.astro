---
import BrandMark from './BrandMark.astro';
import SearchModal from './SearchModal.astro';
import { localeFor, alternatePath, normalizePath } from '../i18n/routes';
const en=localeFor(Astro.url.pathname)==='en';
const path=normalizePath(Astro.url.pathname);
const nav=en? [['Services','/services/'],['How we work','/how-we-work/'],['Pricing','/pricing/'],['Explore AI','/tools/']] : [['Servicios','/servicios/'],['Cómo trabajamos','/como-trabajamos/'],['Precios','/precios-automatizacion-ia/'],['Herramientas','/herramientas/']];
const alternate=alternatePath(path);
---
<a class="skip-link" href="#main-content">{en?'Skip to content':'Saltar al contenido'}</a>
<header class="studio-header" data-pagefind-ignore>
<div class="studio-header__inner">
<BrandMark home={en?'/':'/es/'} />
<nav id="site-nav" class="studio-nav" aria-label={en?'Main navigation':'Navegación principal'}>
{nav.map(([label,href])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}
</nav>
<div class="studio-actions">
{alternate?<a class="studio-language" href={alternate} lang={en?'es':'en'} hreflang={en?'es':'en'} aria-label={en?'Ver esta página en español':'Read this page in English'}>{en?'ES':'EN'}</a>:<a class="studio-language" href={en?'/es/':'/'} lang={en?'es':'en'} aria-label={en?'Spanish home':'English home'}>{en?'ES':'EN'}</a>}
{!en&&<button class="studio-search" type="button" data-search-open aria-label="Buscar en el sitio">⌕</button>}
<a class="studio-cta" href={en?'/assessment/':'/diagnostico-automatizacion-ia/'} data-track-event="service_cta_click" data-track-page-type="navigation" data-track-service="general_consulting" data-track-cluster="general" data-track-placement="header">{en?'Get my free automation assessment':'Evaluar mi proceso'}<span aria-hidden="true">↗</span></a>
<button class="studio-toggle" type="button" data-nav-toggle aria-label={en?'Open menu':'Abrir menú'} aria-expanded="false" aria-controls="site-nav"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></button>
</div></div>
</header>
{!en&&<SearchModal />}
<style>
.studio-header{position:sticky;top:0;z-index:50;background:#171a2bf5;border-bottom:1px solid #303749;color:#fff;backdrop-filter:blur(14px)}.studio-header__inner{width:min(1280px,calc(100% - 64px));margin:auto;min-height:88px;display:flex;align-items:center;justify-content:space-between;gap:26px}.studio-nav{display:flex;gap:27px;align-items:center}.studio-nav a{font:450 14px var(--sans);text-decoration:none;color:#c8cfde;padding:14px 0;white-space:nowrap}.studio-nav a:hover,.studio-nav a[aria-current]{color:#fff}.studio-nav a[aria-current]{box-shadow:0 2px #8fa6ff}.studio-actions{display:flex;align-items:center;gap:14px}.studio-language,.studio-search{flex-shrink:0;display:grid;place-items:center;width:44px;height:44px;border:1px solid #46506a;border-radius:8px;background:transparent;color:#dce4f8;text-decoration:none;font-size:13px}.studio-search{font-size:25px;cursor:pointer}.studio-cta{display:flex;gap:18px;align-items:center;justify-content:center;padding:13px 17px;min-height:46px;border-radius:8px;background:linear-gradient(110deg,#315bda,#6944bf 70%,#963d88);color:white;text-decoration:none;font-size:13px;font-weight:550;white-space:nowrap}.studio-cta:hover{background:#2545b6}.studio-toggle{flex-shrink:0;display:none;background:transparent;border:1px solid #46506a;color:#fff;border-radius:8px;width:44px;height:44px;place-items:center;cursor:pointer}
@media(max-width:1100px){.studio-nav{gap:18px}.studio-cta{font-size:12px;max-width:165px;white-space:normal}.studio-header__inner{gap:18px}}
@media(max-width:900px){.studio-header__inner{width:calc(100% - 36px);min-height:78px}.studio-toggle{display:grid}.studio-nav{display:none;position:absolute;top:100%;left:0;right:0;background:#171a2b;border-bottom:1px solid #46506a;padding:15px 24px 22px;box-shadow:0 16px 24px #0003;gap:0;flex-direction:column;align-items:stretch}.studio-nav[data-open]{display:flex}.studio-nav a{font-size:16px;padding:16px}.studio-cta{max-width:none}.studio-search{display:none}}
@media(max-width:600px){.studio-header__inner{gap:10px}.studio-actions{gap:7px}.studio-cta{display:none}.studio-language{width:44px}.studio-toggle{width:44px}}
</style>
<script>
import { setupNav } from '../scripts/nav';
let cleanup=()=>{};
document.addEventListener('astro:page-load',()=>{cleanup();cleanup=setupNav();});
document.addEventListener('astro:before-swap',()=>cleanup());
</script>
