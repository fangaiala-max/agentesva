---
// Ticker + cabecera sticky del directorio "Futurista".
import SearchModal from './SearchModal.astro';
import { getCollection } from 'astro:content';
import { toolsClaim } from '../data/tools';
import { frescura, ultimaActualizacion } from '../data/frescura';
import { crumbPath, DIAGNOSTICO, NAVEGACION_COMERCIAL, SECCIONES } from '../data/breadcrumbs';

const [tools, estudios, noticias] = await Promise.all([
  getCollection('tools'),
  getCollection('estudios'),
  getCollection('noticias'),
]);

// Claim del ticker derivado del dato real (redondeado a la baja).
const claim = toolsClaim(tools.length);

// Frescura real del sitio: última fecha editorial publicada. Cuando exista
// `addedAt` en tools, añadir aquí las altas del directorio como señal.
const fresca = frescura(
  ultimaActualizacion([
    ...estudios.map((e) => e.data.actualizado ?? e.data.fecha),
    ...noticias.map((n) => n.data.fecha),
  ]),
);
const tickerItems = `+${claim} herramientas de IA revisadas  ·  Sin ruido, solo lo que funciona  ·  Asistentes  ·  Automatización  ·  WhatsApp  ·  Marketing  ·  Pack de Recursos IA gratis  ·  `;
---

<!-- ===== TICKER ===== -->
<div style="border-bottom: 1px solid var(--line); overflow: hidden; background: var(--bg-2);">
  <div style="display: flex; align-items: center;">
    {fresca && (
      <div style="flex: none; display: flex; align-items: center; gap: 8px; padding: 9px 18px; border-right: 1px solid var(--line); background: var(--panel-3);">
        <span
          style={`width: 7px; height: 7px; border-radius: 50%; background: ${fresca.fresco ? 'var(--green)' : 'var(--fg-4)'};${fresca.fresco ? ' animation: dotPulse 1.6s ease-in-out infinite;' : ''}`}
        ></span>
        <time
          datetime={fresca.iso}
          style="font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-2); white-space: nowrap;"
        >{fresca.label}</time>
      </div>
    )}
    <div style="overflow: hidden; flex: 1; white-space: nowrap;">
      <div style="display: inline-flex; animation: marquee 28s linear infinite; will-change: transform;">
        <span style="font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-5); padding: 9px 0;">{tickerItems}</span>
        <span aria-hidden="true" style="font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-5); padding: 9px 0;">{tickerItems}</span>
      </div>
    </div>
  </div>
</div>

<!-- ===== HEADER ===== -->
<header style="position: sticky; top: 0; z-index: 50; background: rgba(10,26,51,0.82); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line);">
  <div class="site-header__inner" style="max-width: 1200px; margin: 0 auto; padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
    <a href="/" style="display: flex; flex:none; align-items: baseline; gap: 3px; text-decoration: none;">
      <span style="font-family: var(--serif); font-weight: 400; font-size: 24px; letter-spacing: -0.025em; color: #fff;">AgentesVA</span>
      <sup style="font-family: var(--mono); font-size: 10px; font-weight: 600; color: var(--accent); top: -0.7em; animation: glowPulse 3s ease-in-out infinite; border-radius: 3px;">[IA]</sup>
    </a>
    <nav id="site-nav" class="sitenav" aria-label="Principal" style="display: flex; gap: 24px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;">
      {
        [...NAVEGACION_COMERCIAL, SECCIONES.herramientas, SECCIONES.estudios].map((s, i) => (
          <a class="navlink site-navlink" href={crumbPath(s.url)} style={`color: ${i === 0 ? '#fff' : 'var(--fg-4)'}; text-decoration: none;`}>
            {s.name}
          </a>
        ))
      }
    </nav>
    <div style="display: flex; align-items: center; gap: 14px;">
      <button
        type="button"
        class="navtoggle"
        data-nav-toggle
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="navtoggle__bars" aria-hidden="true"></span>
      </button>
      <button type="button" class="header-search" data-search-open aria-label="Buscar en el sitio (⌘K)" style="display: flex; align-items: center; gap: 8px; background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 6px; padding: 8px 11px; cursor: pointer;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--fg-3)" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
        <span style="font-family: var(--mono); font-size: 10px; color: var(--fg-5); border: 1px solid var(--line-2); border-radius: 4px; padding: 2px 6px;">⌘K</span>
      </button>
      <a href={crumbPath(DIAGNOSTICO.url)} class="shimmer magnetic" data-magnetic style="font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--bg); background: var(--accent); padding: 9px 18px; border-radius: 2px; text-decoration: none; animation: glowPulse 3.4s ease-in-out infinite;">Diagnóstico</a>
    </div>
  </div>
</header>
<style>
  .site-navlink { position: relative; padding: 6px 0; }
  .site-navlink::after { position: absolute; right: 50%; bottom: 0; left: 50%; height: 1px; background: var(--accent); box-shadow: 0 0 8px rgba(91,124,255,.75); content: ''; transition: right .28s cubic-bezier(.22,.8,.3,1), left .28s cubic-bezier(.22,.8,.3,1); }
  .site-navlink:hover::after, .site-navlink:focus-visible::after { right: 0; left: 0; }
  .header-search { position: relative; overflow: hidden; transition: transform .25s, border-color .25s, box-shadow .25s; }
  .header-search::before { position: absolute; inset: 0; background: linear-gradient(110deg,transparent,rgba(91,124,255,.14),transparent); content: ''; transform: translateX(-110%); transition: transform .48s; }
  .header-search > * { position: relative; }
  .header-search:hover { transform: translateY(-2px); border-color: var(--accent)!important; box-shadow: 0 8px 25px rgba(91,124,255,.16); }
  .header-search:hover::before { transform: translateX(110%); }
  .header-search svg { transition: transform .3s; }
  .header-search:hover svg { transform: rotate(-9deg) scale(1.08); }
  @media(max-width:767px){.site-header__inner{padding:14px 16px!important;gap:10px!important}}
  @media(prefers-reduced-motion:reduce){.site-navlink::after,.header-search,.header-search::before,.header-search svg{transition:none}.header-search:hover{transform:none}}
</style>
<SearchModal />

<script>
  import { setupNav } from '../scripts/nav';

  // Los listeners van a `document`, que sobrevive a las navegaciones cliente de
  // ClientRouter, así que hay que soltar los de la página anterior antes de
  // cablear los nuevos para que no se acumulen (mismo patrón que SearchModal).
  let teardown: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    teardown?.();
    teardown = setupNav();
  });
</script>
