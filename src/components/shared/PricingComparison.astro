---
import {localeFor} from '../../i18n/routes';
import {offerPrice} from '../../data/service-offer';
import AssessmentCTA from './AssessmentCTA.astro';
const locale=localeFor(Astro.url.pathname);const en=locale==='en';
const offers=[{id:'workshop',name:en?'Scope workshop':'Taller de alcance',outcome:en?'Process map and a clear scope':'Mapa del proceso y alcance claro',time:en?'Agreed in the proposal':'Acordado en la propuesta',delivery:en?'Recommended plan and risk assessment':'Plan recomendado y evaluación de riesgos'},{id:'scoped',name:en?'First implementation':'Primera implementación',outcome:en?'One tested, working flow':'Un flujo probado y operativo',time:en?'2–4 weeks':'2–4 semanas',delivery:en?'Tests, training and operating notes':'Pruebas, formación y documentación'},{id:'integrated',name:en?'Several integrations':'Varias integraciones',outcome:en?'Connected workflows across tools':'Flujos conectados entre herramientas',time:en?'4–8 weeks':'4–8 semanas',delivery:en?'Tests, documentation and launch support':'Pruebas, documentación y apoyo al lanzamiento'}] as const;
---
<section id="compare" class="en-section en-shell" data-shared-pricing><div class="en-section-heading"><h2>{en?'Choose the right starting point.':'Elige el punto de partida adecuado.'}</h2><p>{en?'Start with a free assessment. Discovery, implementation and support solve different needs.':'Empieza con un diagnóstico gratuito. El alcance, la implementación y el soporte responden a necesidades distintas.'}</p></div><p>{en?'On small screens, scroll within the table to compare.':'En pantallas pequeñas, desliza dentro de la tabla para comparar.'}</p><div class="en-table-scroll" tabindex="0" role="region" aria-label={en?'Service comparison':'Comparación de servicios'}><table class="en-comparison"><caption>{en?'Indicative starting prices. VAT and third-party costs are detailed separately.':'Precios orientativos desde. IVA y costes de terceros se detallan por separado.'}</caption><thead><tr><th scope="col">{en?'What you need':'Qué necesitas'}</th>{offers.map(o=><th scope="col">{o.name}</th>)}</tr></thead><tbody><tr><th scope="row">{en?'Starting investment':'Inversión inicial'}</th>{offers.map(o=><td><strong>{offerPrice(o.id,locale)}</strong></td>)}</tr><tr><th scope="row">{en?'Outcome':'Resultado'}</th>{offers.map(o=><td>{o.outcome}</td>)}</tr><tr><th scope="row">{en?'Typical timing':'Plazo orientativo'}</th>{offers.map(o=><td>{o.time}</td>)}</tr><tr><th scope="row">{en?'What you receive':'Qué recibes'}</th>{offers.map(o=><td>{o.delivery}</td>)}</tr><tr><th scope="row">{en?'Next step':'Siguiente paso'}</th>{offers.map(o=><td><AssessmentCTA placement="pricing_option" offer={o.id} pageType="pricing" label={en?'Assess this option':'Evaluar esta opción'}/></td>)}</tr></tbody></table></div><div class="en-support"><h3>{en?'Support & optimization':'Soporte y optimización'}</h3><strong>{offerPrice('support',locale)}</strong><p>{en?'Agreed maintenance, adjustments and reviews of active workflows. Scope and response times are confirmed in the proposal.':'Mantenimiento, ajustes y revisión de flujos activos. El alcance y los tiempos de respuesta se confirman en la propuesta.'}</p><AssessmentCTA placement="pricing_support" offer="support" pageType="pricing" label={en?'Discuss support':'Consultar soporte'}/></div></section>
