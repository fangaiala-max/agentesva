---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import ChaosFlow from '../english/ChaosFlow.astro';
import AutomationDemo from '../english/AutomationDemo.astro';
import Integrations from '../english/Integrations.astro';
import { services as servicesEN } from '../../i18n/services';
import '../../styles/agency-home.css';
import '../../styles/english-home.css';
import {servicesES} from '../../i18n/services-es';
import {localeFor} from '../../i18n/routes';
import {ui,localizedPath,assessmentHref} from '../../i18n/parity';
import {offerPrice} from '../../data/service-offer';
import AutomationDemoES from '../home/AutomationDemo.astro';
import IntegrationsES from '../home/Integrations.astro';
const locale=localeFor(Astro.url.pathname), en=locale==='en';
const t=(s:string)=>ui(locale,s), href=(s:string)=>localizedPath(locale,s);
const services=en?servicesEN:servicesES;
const tracking = { 'data-track-event': 'service_cta_click', 'data-track-page-type': 'home', 'data-track-content-slug': 'home', 'data-track-service': 'general_consulting', 'data-track-cluster': 'general' };
---
<BaseLayout title={t("AI automation for small businesses | AgentesVA")} description={t("Connect customer support, sales, and operations with AI workflows your team can understand. Try a demo or take a free automation assessment.")}>
<SiteHeader />
<main id="main-content" class="agency-home english-home" data-pagefind-body>
<section id="hero" class="agency-hero" aria-labelledby="hero-title"><div class="agency-shell hero-layout"><div class="hero-copy"><span class="hero-eyebrow">{t("AI automation for small businesses")}</span><h1 id="hero-title">{t("Less chasing.")}<br />{' '}{t("More moving forward.")}</h1><p class="hero-description" data-motion-static="explanation">{t("We connect your tools and automate the repetitive work between them. Clear workflows. Tested handovers. Your team in control.")}</p><div class="hero-actions" data-motion-static="actions"><a class="agency-button primary" href={assessmentHref(locale,"hero")} {...tracking} data-track-placement="hero">{t("Get my free automation assessment")}<span aria-hidden="true">↗</span></a><a class="agency-button secondary" href="#demo">{t("Try the demo")}</a></div><p class="hero-assurance" data-motion-static="trust">{t("About 3 minutes · Get an initial recommendation.")}</p></div><ChaosFlow /></div><div class="agency-shell hero-foot"><span>{t("Customer support, sales, and operations. Connected.")}</span><a href="#services">{t("Explore what we build")}<span aria-hidden="true">↓</span></a></div></section>
<section id="services" class="home-services"><div class="agency-shell"><div class="section-heading"><h2>{t("One less bottleneck.")}<br />{' '}{t("One better way to work.")}</h2><p>{t("Start where your team feels the friction.")}<br />{' '}{t("Build around a real, recurring task.")}</p></div><div class="home-service-rows">{services.map(s=><a href={href(`/services/${s.slug}/`)} {...tracking} data-track-service={s.service} data-track-cluster={s.cluster} data-track-placement="service_card"><h3>{s.title}</h3><p>{s.description}</p><span aria-hidden="true">↗</span></a>)}</div></div></section>
{en?<AutomationDemo />:<AutomationDemoES />}
<section class="process-section" aria-labelledby="process-title"><div class="agency-shell"><div class="section-heading"><div><span class="section-number">{t("A practical way to start")}</span><h2 id="process-title">{t("Clarity first.")}<br />{' '}{t("Then investment.")}</h2></div><p>{t("A defined scope and a useful outcome.")}<br />{' '}{t("Start with one part of your business.")}</p></div><div class="buying-path"><article><span class="path-index">01</span><h3>{t("Find the opportunity")}</h3><p>{t("Identify a recurring task, its frequency, and the person responsible.")}</p><strong>{t("Free")}</strong><small>{t("Initial assessment · About 3 minutes")}</small></article><article><span class="path-index">02</span><h3>{t("Define the scope")}</h3><p>{t("Map the flow, the exceptions, and what a successful result looks like.")}</p><strong>{offerPrice('workshop',locale)}</strong><small>{t("A scope workshop, when needed")}</small></article><article><span class="path-index">03</span><h3>{t("Build & hand over")}</h3><p>{t("Connect, test, and document a working flow your team can operate.")}</p><strong>{offerPrice('scoped',locale)}</strong><small>{t("Typically 2–4 weeks · Defined scope")}</small></article></div><div class="scope-footer"><p>{t("Indicative starting prices. Your proposal depends on tools, data, permissions, and exceptions. VAT and third-party costs are detailed separately.")}</p><div><a href={href("/pricing/")} {...tracking} data-track-placement="pricing">{t("Explore pricing and scope")}</a><a href={href("/how-we-work/")} {...tracking} data-track-placement="methodology">{t("How we work")}</a></div></div><details class="handover-example"><summary>{t("See the documentation behind this demo")}</summary><p>{t("A real technical handover for the simulation on this page: inputs, exception handling, human review, and acceptance checks. This documents our own demonstration, not a client deployment.")}</p><a href="/examples/demo-handover.md" download>{t("Download the demo handover (English, Markdown)")}</a></details><div class="delivery-strip"><span>{t("What you receive")}</span><p>{t("A working workflow")}</p><p>{t("Tested cases")}</p><p>{t("Documentation & handover")}</p></div></div></section>
{en?<Integrations />:<IntegrationsES />}
<section class="diagnostic-close" aria-labelledby="close-title"><div class="agency-shell close-layout"><div><h2 id="close-title">{t("What keeps repeating")}<br />{' '}{t("in your week?")}</h2><p>{t("Tell us about the process. We will help you decide where to start.")}</p></div><div><a href={assessmentHref(locale,"mid_page")} class="agency-button primary" {...tracking} data-track-placement="mid_page">{t("Get my free automation assessment")}<span aria-hidden="true">↗</span></a><small>{t("About 3 minutes · Get an initial recommendation.")}</small></div></div></section>
<section class="resource-section" aria-labelledby="resource-title"><div class="agency-shell resource-layout"><div><span class="section-number">{t("Build your understanding")}</span><h2 id="resource-title">{t("Useful AI starts")}<br />{' '}{t("with a good question.")}</h2><p>{t("Explore practical tools, guides, and examples to help you make a more informed decision.")}</p><div class="resource-links"><a href={href("/tools/")}>{t("Find an AI tool")}<span aria-hidden="true">↗</span></a><a href={href("/guides/")}>{t("Read a practical guide")}<span aria-hidden="true">↗</span></a><a href={href("/research/")}>{t("Explore our research")}<span aria-hidden="true">↗</span></a></div></div><div class="home-resource-feature"><span class="sample-label">{t("A starting point you can use today")}</span><h3>{t("Give the AI")}<br />{' '}{t("a better brief.")}</h3><p>{t("A clear task, useful context, and a definition of a good result. Explore practical prompts for everyday business work.")}</p><a class="agency-button secondary" href={href("/prompt-library/")}>{t("Explore the prompt library")}</a><p class="home-resource-note">{t("Also available:")}<a href={href("/courses/")}>{t("AI courses")}</a>{t("and")}<a href={href("/resources/")}>{t("downloadable resources")}</a>.</p></div></div></section>
</main><SiteFooter hideNewsletter />
<aside id="cta-bar" class="agency-sticky" aria-label={t("Free assessment")} hidden><span>{t("Make your first workflow clearer.")}</span><a href={assessmentHref(locale,"sticky")} {...tracking} data-track-placement="sticky">{t("Get my free automation assessment")}<span aria-hidden="true">↗</span></a><button type="button" id="cta-dismiss" aria-label={t("Dismiss the assessment reminder")}>×</button></aside>
</BaseLayout>
<script>
import { initAgencyHome, teardownAgencyHome } from '../../scripts/agency-home-en';
import { initAgencyHome as initES, teardownAgencyHome as teardownES } from '../../scripts/agency-home';
document.addEventListener('astro:page-load', () => { document.documentElement.lang==='en'?initAgencyHome():initES(); });
document.addEventListener('astro:before-swap', () => {teardownAgencyHome();teardownES();});
</script>
