---
interface Props { slug: string; placement: 'after_answer' | 'final'; service: { nombre: string; href: string; cluster: string; analytics: { cluster: 'customer_service' | 'sales' | 'operations' | 'general'; service: 'customer_service_automation' | 'sales_automation' | 'process_automation' | 'general_consulting' }; titulo: string; descripcion: string } }
const { slug, placement, service } = Astro.props;
---
<aside class="guide-cta">
  <span>Siguiente decisión</span>
  <h2>{service.titulo}</h2>
  <p>{service.descripcion}</p>
  <a href={service.href} data-track-event="service_cta_click" data-track-page-type="guide" data-track-content-slug={slug} data-track-service={service.analytics.service} data-track-cluster={service.analytics.cluster} data-track-placement={placement}>
    {placement === 'after_answer' ? 'Ver cómo lo implementamos →' : 'Evaluar mi caso →'}
  </a>
</aside>
<style>
  .guide-cta{position:relative;overflow:hidden;margin-top:28px;padding:26px;border:1px solid color-mix(in srgb,var(--accent) 45%,var(--line));border-radius:12px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 12%,var(--panel)),var(--panel));box-shadow:0 18px 50px rgba(0,0,0,.12)}.guide-cta::after{position:absolute;inset:-80% -20% auto auto;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(91,124,255,.2),transparent 68%);content:'';pointer-events:none;animation:cta-drift 8s ease-in-out infinite}.guide-cta span,.guide-cta h2,.guide-cta p,.guide-cta a{position:relative;z-index:1}.guide-cta span{color:var(--accent);font:600 10px var(--mono);letter-spacing:.14em;text-transform:uppercase}.guide-cta h2{margin:9px 0 0;color:#fff;font:600 21px var(--sans)}.guide-cta p{margin:9px 0 0;color:var(--fg-2);line-height:1.6}.guide-cta a{display:inline-block;margin-top:17px;padding:11px 16px;border-radius:4px;background:var(--accent);color:var(--bg);font-weight:700;text-decoration:none;transition:transform .25s,box-shadow .25s}.guide-cta a:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(91,124,255,.3)}.guide-cta a:focus-visible{outline:3px solid #fff;outline-offset:3px}@keyframes cta-drift{50%{transform:translate(-18px,18px) scale(1.08)}}@media(prefers-reduced-motion:reduce){.guide-cta::after{animation:none}.guide-cta a{transition:none}.guide-cta a:hover{transform:none}}
</style>
