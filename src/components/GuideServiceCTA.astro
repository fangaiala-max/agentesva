---
interface Props { slug: string; placement: 'after_answer' | 'final'; service: { nombre: string; href: string; cluster: string; titulo: string; descripcion: string } }
const { slug, placement, service } = Astro.props;
---
<aside class="guide-cta">
  <span>Siguiente decisión</span>
  <h2>{service.titulo}</h2>
  <p>{service.descripcion}</p>
  <a href={service.href} data-track-event="service_cta_click" data-track-page-type="guide" data-track-content-slug={slug} data-track-service={service.nombre} data-track-cluster={service.cluster} data-track-placement={placement}>
    {placement === 'after_answer' ? 'Ver cómo lo implementamos →' : 'Evaluar mi caso →'}
  </a>
</aside>
<style>
  .guide-cta{margin-top:28px;padding:24px;border:1px solid color-mix(in srgb,var(--accent) 45%,var(--line));border-radius:10px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 9%,var(--panel)),var(--panel))}.guide-cta span{color:var(--accent);font:600 10px var(--mono);letter-spacing:.14em;text-transform:uppercase}.guide-cta h2{margin:9px 0 0;color:#fff;font:600 21px var(--sans)}.guide-cta p{margin:9px 0 0;color:var(--fg-2);line-height:1.6}.guide-cta a{display:inline-block;margin-top:17px;padding:11px 16px;border-radius:3px;background:var(--accent);color:var(--bg);font-weight:700;text-decoration:none}
</style>
