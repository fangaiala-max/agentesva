---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SystemPreview from '../components/english/SystemPreview.astro';
import AutomationDemo from '../components/english/AutomationDemo.astro';
import Integrations from '../components/english/Integrations.astro';
import { services } from '../i18n/services';
import '../styles/agency-home.css';
import '../styles/english-home.css';
const tracking = { 'data-track-event': 'service_cta_click', 'data-track-page-type': 'home', 'data-track-content-slug': 'home', 'data-track-service': 'general_consulting', 'data-track-cluster': 'general' };
---
<BaseLayout title="AI automation for small businesses | AgentesVA" description="Connect customer support, sales, and operations with AI workflows your team can understand. Try a demo or take a free automation assessment.">
<SiteHeader />
<main id="main-content" class="agency-home english-home" data-pagefind-body>
<section id="hero" class="agency-hero" aria-labelledby="hero-title"><div class="agency-shell hero-layout"><div class="hero-copy"><span class="hero-eyebrow">AI automation for small businesses</span><h1 id="hero-title">Automate the repetitive work.  <br />Keep your team in control.</h1><p class="hero-description" data-motion-static="explanation">We connect your tools and automate the repetitive work between them. Clear workflows. Tested handovers. Your team in control.</p><div class="hero-actions" data-motion-static="actions"><a class="agency-button primary" href="/assessment/" {...tracking} data-track-placement="hero">Get my free automation assessment <span aria-hidden="true">↗</span></a><a class="agency-button secondary" href="#demo">Try the demo</a></div><p class="hero-assurance" data-motion-static="trust">About 3 minutes · Get an initial recommendation.</p></div><SystemPreview /></div><div class="agency-shell hero-foot"><span>Customer support, sales, and operations. Connected.</span><a href="#services">Explore what we build <span aria-hidden="true">↓</span></a></div></section>
<section id="services" class="home-services"><div class="agency-shell"><div class="section-heading"><h2>One less bottleneck. <br />One better way to work.</h2><p>Start where your team feels the friction. <br />Build around a real, recurring task.</p></div><div class="home-service-rows">{services.map(s=><a href={`/services/${s.slug}/`} {...tracking} data-track-service={s.service} data-track-cluster={s.cluster} data-track-placement="service_card"><h3>{s.title}</h3><p>{s.description}</p><span aria-hidden="true">↗</span></a>)}</div></div></section>
<AutomationDemo />
<section class="process-section" aria-labelledby="process-title"><div class="agency-shell"><div class="section-heading"><div><span class="section-number">A practical way to start</span><h2 id="process-title">Clarity first. <br />Then investment.</h2></div><p>A defined scope and a useful outcome. <br />Start with one part of your business.</p></div><div class="buying-path"><article><span class="path-index">01</span><h3>Find the opportunity</h3><p>Identify a recurring task, its frequency, and the person responsible.</p><strong>Free</strong><small>Initial assessment · About 3 minutes</small></article><article><span class="path-index">02</span><h3>Define the scope</h3><p>Map the flow, the exceptions, and what a successful result looks like.</p><strong>From €300</strong><small>A scope workshop, when needed</small></article><article><span class="path-index">03</span><h3>Build & hand over</h3><p>Connect, test, and document a working flow your team can operate.</p><strong>From €1,500</strong><small>Typically 2–4 weeks · Defined scope</small></article></div><div class="scope-footer"><p>Indicative starting prices. Your proposal depends on tools, data, permissions, and exceptions. VAT and third-party costs are detailed separately.</p><div><a href="/pricing/" {...tracking} data-track-placement="pricing">Explore pricing and scope</a><a href="/how-we-work/" {...tracking} data-track-placement="methodology">How we work</a></div></div><details class="handover-example"><summary>See the documentation behind this demo</summary><p>A real technical handover for the simulation on this page: inputs, exception handling, human review, and acceptance checks. This documents our own demonstration, not a client deployment.</p><a href="/examples/demo-handover.md" download>Download the demo handover (English, Markdown)</a></details><div class="delivery-strip"><span>What you receive</span><p>A working workflow</p><p>Tested cases</p><p>Documentation & handover</p></div></div></section>
<Integrations />
<section class="diagnostic-close" aria-labelledby="close-title"><div class="agency-shell close-layout"><div><h2 id="close-title">What keeps repeating <br />in your week?</h2><p>Tell us about the process. We will help you decide where to start.</p></div><div><a href="/assessment/" class="agency-button primary" {...tracking} data-track-placement="mid_page">Get my free automation assessment <span aria-hidden="true">↗</span></a><small>About 3 minutes · Get an initial recommendation.</small></div></div></section>
<section class="resource-section" aria-labelledby="resource-title"><div class="agency-shell resource-layout"><div><span class="section-number">Build your understanding</span><h2 id="resource-title">Useful AI starts <br />with a good question.</h2><p>Explore practical tools, guides, and examples to help you make a more informed decision.</p><div class="resource-links"><a href="/tools/">Find an AI tool <span aria-hidden="true">↗</span></a><a href="/guides/">Read a practical guide <span aria-hidden="true">↗</span></a><a href="/research/">Explore our research <span aria-hidden="true">↗</span></a></div></div><div class="home-resource-feature"><span class="sample-label">A starting point you can use today</span><h3>Give the AI <br />a better brief.</h3><p>A clear task, useful context, and a definition of a good result. Explore practical prompts for everyday business work.</p><a class="agency-button secondary" href="/prompt-library/">Explore the prompt library</a><p class="home-resource-note">Also available: <a href="/courses/">AI courses</a> and <a href="/resources/">downloadable resources</a>.</p></div></div></section>
</main><SiteFooter hideNewsletter />
<aside id="cta-bar" class="agency-sticky" aria-label="Free assessment" hidden><span>Make your first workflow clearer.</span><a href="/assessment/" {...tracking} data-track-placement="sticky">Get my free automation assessment <span aria-hidden="true">↗</span></a><button type="button" id="cta-dismiss" aria-label="Dismiss the assessment reminder">×</button></aside>
</BaseLayout>
<script>
import { initAgencyHome, teardownAgencyHome } from '../scripts/agency-home-en';
document.addEventListener('astro:page-load', () => { if(document.documentElement.lang==='en') initAgencyHome(); });
document.addEventListener('astro:before-swap', teardownAgencyHome);
</script>
