    .buyer-path{padding:68px 20px}.buyer-path__steps{grid-template-columns:1fr}.buyer-path__steps li{min-height:auto;border-right:0!important;border-bottom:1px solid var(--line-2)!important}.buyer-path__steps strong{margin-top:28px}.buyer-path__close a{text-align:center}
    .cat-grid { grid-template-columns: 1fr; }
