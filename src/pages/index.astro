  .hero-cta { position: relative; display: inline-flex; overflow: hidden; align-items: center; gap: 9px; padding: 14px 21px; border-radius: var(--radius-pill); font-weight: 700; text-decoration: none; text-transform:uppercase; font-size:12px; letter-spacing:.04em; transition: transform .4s var(--ease-out-expo), border-color .28s, box-shadow .28s, background .28s; }
  .hero-cta i { position: relative; z-index: 2; font-style: normal; transition: transform .28s cubic-bezier(.22,.8,.3,1); }
