  .hero-cta--secondary { border: 1px solid rgba(255,255,255,.65); color: #fff; }
  .hero-cta--secondary::before { position: absolute; inset: 0; background: linear-gradient(110deg, transparent, rgba(91,124,255,.13)); content: ''; transform: translateX(-105%); transition: transform .42s ease; }
  .hero-cta--secondary:hover { border-color: var(--accent); transform: translateY(-2px); }
  .hero-cta--secondary:hover::before { transform: translateX(0); }
  .hero-search { position: relative; overflow: hidden; isolation: isolate; background:#fff!important; border:0!important; border-radius:var(--radius-pill)!important; }
  .hero-search input { color:#050505!important; }
  .hero-search input::placeholder { color:#686868; }
  .hero-search__button { border-radius:var(--radius-pill)!important; background:#050505!important; color:#fff!important; }
  .hero-search::after { position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: radial-gradient(180px circle at 18% 50%, rgba(91,124,255,.15), transparent 70%); content: ''; opacity: 0; transform: scale(.82); transition: opacity .3s, transform .4s; pointer-events: none; }
