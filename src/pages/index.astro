        <div style="display: flex; align-items: baseline; gap: 2px;">
          <span data-count="30" style="font-weight: 700; font-size: 42px; color: #fff; letter-spacing: -0.03em; font-variant-numeric: tabular-nums;">30</span>
          <span style="font-weight: 700; font-size: 42px; color: var(--accent); letter-spacing: -0.03em;">+</span>
        </div>
        <span style="font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-5);">Prompts en el pack</span>
      </div>
      <div class="reveal" style="padding: 40px 24px;">
        <div style="display: flex; align-items: baseline; gap: 2px;">
          <span style="font-weight: 700; font-size: 42px; color: #fff; letter-spacing: -0.03em;">+</span>
          <span data-count="1200" style="font-weight: 700; font-size: 42px; color: #fff; letter-spacing: -0.03em; font-variant-numeric: tabular-nums;">1.200</span>
        </div>
        <span style="font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-5);">Negocios suscritos</span>
      </div>
    </div>
  </section>
  </main>

  <SiteFooter />

  <!-- ===== BARRA CTA FIJA (fondo sólido: sin backdrop-filter permanente) ===== -->
  <div id="cta-bar" hidden style="position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; background: var(--bg-2); border-top: 1px solid var(--line-2); animation: slideUp .4s cubic-bezier(0.22,0.61,0.36,1) both;">
    <div style="max-width: 1240px; margin: 0 auto; padding: 12px 32px; display: flex; align-items: center; gap: 18px; flex-wrap: wrap;">
      <span aria-hidden="true" style="width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex: none;"></span>
      <span style="font-family: var(--sans); font-size: 14.5px; color: #fff; font-weight: 600; flex: 1; min-width: 200px;">¿Tienes un proceso repetitivo? <span style="color: var(--fg-3); font-weight: 400;">Descubre si merece la pena automatizarlo.</span></span>
      <a href="/diagnostico-automatizacion-ia/" style="font-family: var(--sans); font-weight: 700; font-size: 12px; text-transform:uppercase; color: #fff; background: var(--accent); padding: 11px 20px; border-radius:var(--radius-pill); text-decoration: none; white-space: nowrap;">Diagnóstico gratuito →</a>
      <button type="button" id="cta-dismiss" aria-label="Cerrar aviso" style="background: none; border: none; cursor: pointer; color: var(--fg-5); padding: 6px; display: flex;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
  </div>

  <!-- ===== BARRA DE COMPARACIÓN ===== -->
  <div id="compare-bar" hidden style="position: fixed; left: 0; right: 0; bottom: 0; z-index: 61; background: rgba(12,30,60,0.95); backdrop-filter: blur(10px); border-top: 1px solid var(--accent); animation: slideUp .4s cubic-bezier(0.22,0.61,0.36,1) both;">
    <div style="max-width: 1240px; margin: 0 auto; padding: 12px 32px; display: flex; align-items: center; gap: 18px; flex-wrap: wrap;">
      <span style="font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); flex: none;">Comparar</span>
      <div id="compare-chips" style="display: flex; align-items: center; gap: 8px; flex: 1; flex-wrap: wrap;"></div>
      <span id="compare-hint" aria-live="polite" style="font-family: var(--mono); font-size: 11px; color: var(--fg-5);">Añade hasta 3</span>
      <div style="display: flex; align-items: center; gap: 10px; flex: none;">
        <button type="button" id="compare-clear" style="background: none; border: 1px solid var(--line-2); border-radius: 2px; cursor: pointer; color: var(--fg-3); font-family: var(--sans); font-size: 13px; padding: 10px 14px;">Vaciar</button>
        <button type="button" id="compare-open" class="lift" style="background: var(--accent); color: var(--bg); border: none; padding: 10px 20px; border-radius: 2px; font-family: var(--sans); font-weight: 600; font-size: 13.5px; cursor: pointer; white-space: nowrap;">Comparar →</button>
      </div>
    </div>
  </div>

  <!-- ===== MODAL DE COMPARACIÓN ===== -->
  <div id="compare-overlay" hidden style="position: fixed; inset: 0; z-index: 80; background: rgba(6,16,32,0.72); backdrop-filter: blur(4px); display: flex; align-items: flex-start; justify-content: center; padding: 48px 24px; overflow-y: auto; animation: fadeIn .2s both;">
    <div role="dialog" aria-modal="true" aria-label="Comparativa de herramientas" style="width: 100%; max-width: 980px; background: var(--bg-2); border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; animation: fadeUp .3s cubic-bezier(0.22,0.61,0.36,1) both;">
      <div style="display: flex; align-items: center; justify-content: space-between; padding: 20px 26px; border-bottom: 1px solid var(--line);">
        <div style="display: flex; align-items: baseline; gap: 10px;">
          <h2 style="font-family: var(--serif); font-weight: 400; font-size: 24px; letter-spacing: -0.02em; margin: 0; color: #fff;">Comparativa</h2>
          <span id="compare-count" style="font-family: var(--mono); font-size: 11px; color: var(--fg-5);"></span>
        </div>
        <button type="button" id="compare-close" aria-label="Cerrar comparativa" style="background: none; border: 1px solid var(--line-2); border-radius: 4px; cursor: pointer; color: var(--fg-3); padding: 8px; display: flex;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
      </div>
      <div style="padding: 8px 26px 26px; overflow-x: auto;">
        <div id="compare-table" style="display: grid; min-width: 640px;"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .reach-home-hero { min-height: 760px; background:var(--accent); color:#fff; isolation:isolate; --mx:72%; --my:34%; }
  .reach-home-hero.spotlight::before { z-index:-1; opacity:1; background:radial-gradient(520px circle at var(--mx) var(--my),rgba(255,255,255,.24),transparent 64%); transition:opacity .3s; }
  .reach-home-hero::after { position: absolute; inset: auto 0 0; height: 18%; background: linear-gradient(transparent,rgba(0,0,0,.22)); content: ''; pointer-events: none; z-index: -1; }
  .signal-grid { position:absolute; inset:0; z-index:-2; opacity:.22; background-image:linear-gradient(rgba(255,255,255,.24) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.24) 1px,transparent 1px); background-size:72px 72px; mask-image:linear-gradient(to bottom,transparent,black 28%,black 80%,transparent); }
  .signal-orbit { position:absolute; right:-6vw; top:4rem; z-index:-1; width:min(52vw,650px); aspect-ratio:1; border:1px solid rgba(255,255,255,.28); border-radius:50%; }
  .signal-orbit::before,.signal-orbit::after{position:absolute;inset:13%;border:1px solid rgba(255,255,255,.23);border-radius:50%;content:''}.signal-orbit::after{inset:31%}
  .signal-orbit span{position:absolute;font:600 10px var(--mono);letter-spacing:.18em}.signal-orbit span:nth-child(1){left:8%;top:28%}.signal-orbit span:nth-child(2){right:12%;top:47%}.signal-orbit span:nth-child(3){left:43%;bottom:-5px}
  .kinetic-type { position:absolute; inset:0; z-index:-1; display:grid; align-content:center; overflow:hidden; opacity:.15; transform:rotate(-7deg) scale(1.1); pointer-events:none; }
  .kinetic-type span { display:block; width:max-content; font:750 clamp(110px,18vw,260px)/.7 var(--display); letter-spacing:-.09em; color:transparent; -webkit-text-stroke:1px #fff; animation:kineticSlide 18s linear infinite; }
  .kinetic-type span:nth-child(2){margin-left:-22vw;animation-direction:reverse;animation-duration:23s}.kinetic-type span:nth-child(3){margin-left:12vw;animation-duration:27s}
  .hero-kicker { display:inline-flex; font:500 11px var(--mono); letter-spacing:.14em; color:#fff; border:1px solid rgba(255,255,255,.6); border-radius:var(--radius-pill); padding:8px 14px; }
  .hero-assurance { margin:14px 0 0!important; color:rgba(255,255,255,.74)!important; font:500 10px/1.5 var(--mono)!important; letter-spacing:.04em; text-transform:uppercase; }
  .reach-home-hero > .hero-grid > div > p { color:rgba(255,255,255,.86)!important; }
  .reach-home-hero .quick-chip { color:#fff!important; border-color:rgba(255,255,255,.55)!important; }
  .reach-home-hero .quick-chip:hover { background:#fff!important; color:#050505!important; }
  .reach-home-hero .hero-grid > div > div:last-child span:last-child { color:rgba(255,255,255,.78)!important; }
  .signal-title { max-width:760px; margin:24px 0 0; font:650 clamp(54px,7.5vw,102px)/.82 var(--display); letter-spacing:-.075em; color:#fff; text-transform:uppercase; }
  .signal-title span { color:#050505; font-style:italic; font-weight:450; }
  .hero-feature { overflow:hidden; background:linear-gradient(145deg,rgba(5,5,5,.97),rgba(11,11,18,.9)); border-radius:0; box-shadow:24px 24px 0 rgba(255,255,255,.14),0 30px 80px rgba(0,0,0,.32); transform:rotate(1.5deg); backdrop-filter:blur(12px); }
  .hero-feature::before { position:absolute; inset:0; background:linear-gradient(110deg,transparent 35%,rgba(41,71,255,.18),transparent 65%); content:''; transform:translateX(-100%); animation:featureSweep 7s var(--ease-out-expo) infinite; pointer-events:none; }
  .hero-feature:hover { transform:rotate(0) translateY(-5px); }
  .decision-card { display:block; position:relative; border:1px solid rgba(255,255,255,.16); padding:30px; animation-delay:.38s; }
  .decision-card::before { display:none; }
  .decision-card__eyebrow { color:var(--accent); font:600 10px var(--mono); letter-spacing:.16em; }
  .decision-card h2 { margin:14px 0 24px; color:#fff; font:600 clamp(30px,3.6vw,48px)/.98 var(--display); letter-spacing:-.055em; text-transform:uppercase; }
  .decision-card ol { display:grid; gap:0; margin:0; padding:0; list-style:none; border-top:1px solid var(--line); }
  .decision-card li { display:grid; grid-template-columns:36px 1fr; gap:12px; padding:15px 0; border-bottom:1px solid var(--line); }
  .decision-card li>span { color:var(--accent); font:600 10px var(--mono); }
  .decision-card strong,.decision-card small { display:block; }.decision-card strong{color:#fff;font:600 14px var(--sans)}.decision-card small{margin-top:4px;color:var(--fg-3);font:12px/1.45 var(--sans)}
  .decision-card>a { display:flex; justify-content:space-between; margin-top:22px; color:#fff; font:700 12px var(--sans); text-transform:uppercase; letter-spacing:.04em; text-decoration:none; }
  .buyer-path { max-width:1240px; margin:0 auto; padding:96px 32px; }
  .buyer-path__intro { display:grid; grid-template-columns:1.4fr .6fr; gap:30px; align-items:end; }.buyer-path__intro>span{grid-column:1/-1;color:var(--accent);font:600 10px var(--mono);letter-spacing:.16em}.buyer-path__intro h2{margin:0;color:#fff;font:600 clamp(38px,5.5vw,70px)/.96 var(--display);letter-spacing:-.055em;text-transform:uppercase}.buyer-path__intro p{margin:0;color:var(--fg-3);font:16px/1.6 var(--sans)}
  .buyer-path__steps { display:grid; grid-template-columns:repeat(4,1fr); margin:52px 0 0; padding:0; list-style:none; border-block:1px solid var(--line-2); }.buyer-path__steps li{min-height:230px;padding:24px;border-right:1px solid var(--line-2)}.buyer-path__steps li:last-child{border:0}.buyer-path__steps li>span{color:var(--accent);font:600 11px var(--mono)}.buyer-path__steps strong{display:block;margin-top:64px;color:#fff;font:600 22px var(--display);text-transform:uppercase}.buyer-path__steps p{margin:9px 0 0;color:var(--fg-3);font:14px/1.5 var(--sans)}
  .buyer-path__close { display:grid; grid-template-columns:1fr 1fr auto; gap:32px; align-items:center; margin-top:24px;padding:22px 24px;background:var(--panel);border:1px solid var(--line)}.buyer-path__close strong,.buyer-path__close span{display:block}.buyer-path__close strong{color:#fff;font:600 13px var(--sans)}.buyer-path__close span{margin-top:4px;color:var(--fg-3);font:12px/1.4 var(--sans)}.buyer-path__close a{padding:13px 18px;border-radius:var(--radius-pill);background:var(--accent);color:#fff;font:700 11px var(--sans);text-transform:uppercase;text-decoration:none;white-space:nowrap}
  @keyframes signalSpin { to { transform:rotate(360deg); } }
  @keyframes kineticSlide { to { transform:translateX(-28vw); } }
