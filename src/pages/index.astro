  .hero-search > svg { transition: color .25s, transform .3s; }
  .hero-search:focus-within > svg { stroke: var(--accent); transform: rotate(-8deg) scale(1.08); }
  .hero-search__button { display: inline-flex; align-items: center; gap: 6px; padding: 11px 18px; border: 1px solid var(--line-2); border-radius: 2px; background: var(--panel-3); color: var(--fg-2); font: 600 11px var(--mono); cursor: pointer; transition: color .25s, border-color .25s, background .25s; }
  .hero-search__button span { transition: transform .25s; }
  .hero-search__button:hover { border-color: var(--accent); background: color-mix(in srgb,var(--accent) 12%,var(--panel-3)); color: #fff; }
  .hero-search__button:hover span { transform: translateX(3px); }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 48px; align-items: center; }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .coll-grid { display: grid; grid-template-columns: 1fr auto; gap: 28px; align-items: center; }
  .dir-body { display: block; }
  .dir-body.shop { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 28px; align-items: start; }
  .dir-sidebar { position: sticky; top: 84px; display: flex; flex-direction: column; gap: 26px; }
  /* los elementos con display inline (flex/grid) necesitan !important para que `hidden` gane */
  .dir-sidebar[hidden],
  #shop-toolbar[hidden],
  #shelves[hidden],
  #chips-row[hidden],
  #tool-grid[hidden],
  #cta-bar[hidden],
  #compare-bar[hidden],
  #compare-overlay[hidden] { display: none !important; }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
    .coll-grid { grid-template-columns: 1fr; }
    .dir-body.shop { grid-template-columns: 1fr; }
    .dir-sidebar { position: static; }
    .buyer-path__intro{grid-template-columns:1fr}.buyer-path__steps{grid-template-columns:repeat(2,1fr)}.buyer-path__steps li:nth-child(2){border-right:0}.buyer-path__steps li:nth-child(-n+2){border-bottom:1px solid var(--line-2)}.buyer-path__close{grid-template-columns:1fr}
  }
  @media (max-width: 560px) {
    .reach-home-hero { min-height:auto; }
