    #cta-bar a { flex:1; text-align:center; padding:12px 14px!important; }
    #cta-dismiss { flex:none; }
  }
  @media (prefers-reduced-motion: reduce) { .signal-orbit,.kinetic-type span,.hero-feature::before{animation:none}.hero-cta,.hero-cta i,.hero-cta--secondary::before,.hero-search::after,.hero-search > svg,.hero-search__button,.hero-search__button span { transition: none; } }
</style>

<script>
  import { initHome } from '../scripts/home';
  import { initMotion } from '../scripts/motion';
  import { setupShelves } from '../scripts/shelves';

  // setupShelves observa y escucha scroll: hay que soltar lo anterior en cada
  // navegación cliente para no acumular observers entre páginas.
  let teardownShelves: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    initHome();
    initMotion();
    teardownShelves?.();
    teardownShelves = setupShelves();
  });
</script>
