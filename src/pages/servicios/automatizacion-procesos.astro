---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CommercialNextSteps from '../../components/CommercialNextSteps.astro';
import AmbientHero from '../../components/AmbientHero.astro';
import { serviceClusterLinks } from '../../data/commercial-links';
import { breadcrumbList, trail as buildTrail } from '../../data/breadcrumbs';
import { jsonLdSerialize, ORG_ID, SITE, WEBSITE_ID } from '../../data/schema';

const trail = buildTrail({ name: 'Servicios', url: '/servicios' }, { name: 'Automatización de procesos', url: '/servicios/automatizacion-procesos' });
const useCases = [
  { title: 'Documentos y datos', text: 'Extrae, valida y traslada datos de facturas, pedidos o formularios sin copiar campo por campo.' },
  { title: 'Reporting recurrente', text: 'Reúne información de varias fuentes y prepara informes con reglas y fuentes visibles.' },
  { title: 'Tareas administrativas', text: 'Activa avisos, aprobaciones y actualizaciones cuando cambia el estado de un proceso.' },
  { title: 'Traspaso entre sistemas', text: 'Sincroniza información entre correo, hojas, gestores y aplicaciones con control de errores.' },
] as const;
const deliverables = ['Mapa del proceso, responsables y excepciones.', 'Definición de entradas, salidas y datos obligatorios.', 'Flujo conectado a las herramientas acordadas.', 'Validaciones, alertas, permisos y revisión humana.', 'Pruebas con casos normales, incompletos y erróneos.', 'Documentación, registro mínimo y formación del responsable.'] as const;
const faqs = [
  { question: '¿Qué proceso conviene automatizar primero?', answer: 'Uno frecuente, estable, con reglas conocidas y una persona responsable. Priorizamos el cuello de botella con datos disponibles y resultado medible, no necesariamente la tarea más vistosa.' },
  { question: '¿Se pueden procesar facturas y otros documentos?', answer: 'Sí, cuando la variedad y calidad permiten extraer datos con una validación razonable. Definimos qué campos requieren comprobación y qué ocurre cuando un documento está incompleto o tiene baja confianza.' },
  { question: '¿Podéis conectar hojas, correo y herramientas internas?', answer: 'Sí, si ofrecen API, webhook, exportación o una integración fiable. Antes confirmamos permisos, límites, propiedad de los datos y cómo recuperar el proceso cuando una conexión falla.' },
  { question: '¿Cuánto cuesta y cuánto tarda?', answer: 'Una implementación acotada parte de 1.500 € y suele requerir de dos a cuatro semanas. Un flujo con varias integraciones parte de 3.000 € y puede requerir de cuatro a ocho semanas.' },
  { question: '¿Cómo se mide el resultado?', answer: 'Usamos una línea base y métricas como tiempo manual por caso, errores detectados, documentos procesados, tareas dentro de plazo o incidencias que requieren revisión.' },
] as const;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: 'Automatización de procesos y operaciones con IA', url: `${SITE}/servicios/automatizacion-procesos/`, description: 'Automatización de documentos, reporting y tareas administrativas para PyMEs.', inLanguage: 'es', isPartOf: { '@id': WEBSITE_ID }, about: { '@id': `${SITE}/servicios/automatizacion-procesos/#service` } },
  { '@type': 'Service', '@id': `${SITE}/servicios/automatizacion-procesos/#service`, name: 'Automatización de procesos y operaciones', serviceType: 'Diseño e implementación de automatizaciones operativas con IA', provider: { '@id': ORG_ID }, url: `${SITE}/servicios/automatizacion-procesos/`, areaServed: 'Países hispanohablantes', audience: { '@type': 'BusinessAudience', audienceType: 'PyMEs y profesionales' }, offers: { '@type': 'AggregateOffer', lowPrice: '1500', priceCurrency: 'EUR', offerCount: '2', description: 'Implementación acotada desde 1.500 €; automatización con varias integraciones desde 3.000 €.' } },
  { '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }, breadcrumbList(trail),
] };
---

<BaseLayout title="Automatización de procesos con IA para PyMEs | AgentesVA" description="Automatiza documentos, informes y tareas administrativas con controles claros. Implementaciones desde 1.500 € y diagnóstico gratuito.">
  <script type="application/ld+json" set:html={jsonLdSerialize(jsonLd)} /><SiteHeader />
  <main><AmbientHero />
    <section class="hero"><div class="shell"><Breadcrumb trail={trail} /><div class="hero__grid"><div><span class="eyebrow">Procesos y operaciones · Automatización con IA</span><h1>Menos trabajo manual entre <span>documentos y sistemas</span></h1><p class="lead">Conectamos datos, documentos y tareas administrativas para que el equipo gestione excepciones en lugar de repetir pasos. Cada flujo queda probado, documentado y supervisable.</p><div class="actions"><a href="/diagnostico-automatizacion-ia/" class="button button--primary" data-track-event="service_cta_click" data-track-page-type="service_detail" data-track-content-slug="automatizacion-procesos" data-track-service="process_automation" data-track-cluster="operations" data-track-placement="hero">Evaluar mi proceso gratis →</a><a href="#flujo" class="button button--secondary">Ver un flujo de ejemplo</a></div><p class="note">3 minutos · Sin compromiso · Una recomendación concreta</p></div><aside class="problem-card"><span class="eyebrow">El problema habitual</span><strong>La misma información pasa por correo, hojas y aplicaciones; cada traspaso consume tiempo y añade errores.</strong><p>La automatización encaja cuando el proceso se repite, sus reglas son observables y sabemos quién resuelve las excepciones.</p></aside></div></div></section>
    <section class="section shell"><header class="section-heading"><span class="eyebrow">Casos de uso</span><h2>Automatiza el trabajo que conecta tus herramientas</h2><p>Empezamos por un tramo estable y medible. No intentamos rediseñar todas las operaciones en un solo proyecto.</p></header><div class="card-grid">{useCases.map((item,index) => <article class="card"><span>0{index+1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
    <section id="flujo" class="section section--dark"><div class="shell"><header class="section-heading"><span class="eyebrow">Ejemplo de flujo</span><h2>De un documento recibido a una tarea completada</h2></header><ol class="flow"><li><span>01</span><div><h3>Entrada</h3><p>Llega un documento, formulario o cambio de estado.</p></div></li><li><span>02</span><div><h3>Validación</h3><p>Se comprueban formato, campos obligatorios y duplicados.</p></div></li><li><span>03</span><div><h3>Acción</h3><p>Se actualizan sistemas, se genera el informe o se activa la tarea.</p></div></li><li><span>04</span><div><h3>Control</h3><p>Se registra el resultado y las excepciones se asignan a una persona.</p></div></li></ol><p class="flow-note"><strong>Ejemplo, no promesa cerrada:</strong> los pasos dependen de tus datos, permisos, herramientas y riesgos.</p></div></section>
    <section class="section shell split"><div><span class="eyebrow">Qué entregamos</span><h2>Un flujo fiable y recuperable</h2><ul class="check-list">{deliverables.map((item)=><li>{item}</li>)}</ul></div><aside class="investment"><span class="eyebrow">Plazo e inversión</span><div><h3>Implementación acotada</h3><strong>Desde 1.500 €</strong><p>Habitualmente, de 2 a 4 semanas.</p></div><div><h3>Varias integraciones</h3><strong>Desde 3.000 €</strong><p>Habitualmente, de 4 a 8 semanas.</p></div><p>El diagnóstico inicial es gratuito. El precio final depende de documentos, volumen, integraciones, permisos, excepciones y soporte. Son rangos orientativos, no presupuestos cerrados.</p></aside></section>
    <section class="section section--panel"><div class="shell limits"><div><span class="eyebrow">Buen encaje</span><h2>Un proceso frecuente y observable</h2><ul><li>Se repite semanalmente o a diario.</li><li>Sus entradas, salidas y responsables están identificados.</li><li>Existen ejemplos reales para probar excepciones.</li><li>Quieres medir antes de ampliar el alcance.</li></ul></div><div><span class="eyebrow">Límites</span><h2>No automatizamos un proceso que nadie controla</h2><ul><li>No ocultamos errores ni rellenamos datos inventados.</li><li>No conectamos sistemas sin permisos y trazabilidad.</li><li>Las decisiones sensibles requieren revisión humana.</li><li>Un proceso inestable debe aclararse antes de automatizarlo.</li></ul></div></div></section>
    <div class="shell"><CommercialNextSteps links={serviceClusterLinks.procesos} title="Guías para preparar la decisión" theme="light" pageType="service_detail" slug="automatizacion-procesos" /></div>
    <section class="section shell faq"><header class="section-heading"><span class="eyebrow">Preguntas frecuentes</span><h2>Antes de automatizar operaciones</h2></header>{faqs.map((faq)=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</section>
    <section class="final-cta"><div class="shell final-cta__inner"><div><span class="eyebrow">Siguiente paso</span><h2>Identifica el primer proceso que merece automatizarse</h2><p>Cuéntanos qué tarea se repite, qué herramientas intervienen y quién resuelve hoy los errores.</p></div><a href="/diagnostico-automatizacion-ia/" class="button button--primary" data-track-event="service_cta_click" data-track-page-type="service_detail" data-track-content-slug="automatizacion-procesos" data-track-service="process_automation" data-track-cluster="operations" data-track-placement="final_cta">Hacer el diagnóstico gratuito →</a></div></section>
  </main><SiteFooter />
</BaseLayout>
<style>
  :global(body){background:#f7f8fa;color:#17211d}.shell{width:min(1120px,calc(100% - 40px));margin-inline:auto}.hero{padding:28px 0 96px;background:radial-gradient(circle at 80% 10%,rgba(235,154,48,.18),transparent 32%),#10231d;color:#fff}.hero__grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(300px,.7fr);gap:64px;align-items:center;margin-top:64px}.eyebrow{display:block;margin-bottom:14px;color:#c66f16;font:700 .74rem/1.4 'JetBrains Mono Variable',monospace;letter-spacing:.12em;text-transform:uppercase}.hero .eyebrow,.section--dark .eyebrow,.final-cta .eyebrow{color:#f1b66f}h1,h2,h3{margin:0;font-family:'DM Serif Display',serif;font-weight:400}h1{max-width:760px;font-size:clamp(3rem,6vw,5.4rem);line-height:.96;letter-spacing:-.04em}h1 span{color:#f1b66f}.lead{max-width:720px;margin:28px 0;color:#d8e6e1;font-size:1.18rem;line-height:1.7}.actions{display:flex;flex-wrap:wrap;gap:12px}.button{display:inline-flex;align-items:center;justify-content:center;padding:14px 20px;border:1px solid transparent;border-radius:6px;font-weight:750;text-decoration:none}.button--primary{background:#c66f16;color:#fff}.button--secondary{border-color:#ffffff4d;color:#fff}.note{color:#9fb8af;font-size:.86rem}.problem-card{padding:34px;border:1px solid #f1b66f4d;border-radius:12px;background:#ffffff0f}.problem-card strong{display:block;font:400 1.7rem/1.25 'DM Serif Display',serif}.problem-card p{color:#b9cec6;line-height:1.65}.section{padding:96px 0}.section-heading{max-width:780px;margin-bottom:42px}.section-heading h2,.split h2,.limits h2{font-size:clamp(2.2rem,4vw,3.5rem);line-height:1.05}.section-heading p{color:#57635e;line-height:1.65}.card-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.card{padding:26px;border:1px solid #dce3df;border-radius:10px;background:#fff}.card>span,.flow>li>span{color:#c66f16;font:700 .75rem 'JetBrains Mono Variable',monospace}.card h3{margin:28px 0 10px;font-size:1.55rem}.card p{margin:0;color:#5d6863;line-height:1.6}.section--dark{background:#10231d;color:#fff}.flow{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;padding:0;list-style:none;background:#ffffff29}.flow li{display:flex;gap:18px;padding:28px;background:#10231d}.flow h3{font-size:1.45rem}.flow p,.flow-note{color:#b9cec6;line-height:1.55}.split,.limits{display:grid;grid-template-columns:1fr 1fr;gap:72px}.check-list,.limits ul{padding:0;list-style:none}.check-list li,.limits li{position:relative;padding:13px 0 13px 30px;border-bottom:1px solid #dce3df}.check-list li::before,.limits li::before{position:absolute;left:0;color:#c66f16;content:'✓'}.investment{padding:34px;border-radius:12px;background:#fff;box-shadow:0 18px 55px #0e231c1a}.investment>div{padding:20px 0;border-bottom:1px solid #dce3df}.investment h3{font-size:1.45rem}.investment strong{display:block;margin-top:8px;color:#a65a10;font-size:1.5rem}.investment p{color:#64706b;line-height:1.55}.section--panel{background:#edf2ef}.limits>div{padding:34px;background:#fff;border-radius:10px}.faq details{border-top:1px solid #d5ddd9}.faq details:last-child{border-bottom:1px solid #d5ddd9}.faq summary{padding:22px 0;font-weight:750;cursor:pointer}.faq details p{max-width:800px;margin:0 0 22px;color:#59655f;line-height:1.65}.final-cta{padding:72px 0;background:#17352b;color:#fff}.final-cta__inner{display:flex;gap:48px;align-items:center;justify-content:space-between}.final-cta h2{font-size:clamp(2rem,4vw,3.2rem)}.final-cta p{max-width:680px;color:#c3d5ce}.final-cta .button{flex:none}@media(max-width:860px){.hero__grid,.split,.limits{grid-template-columns:1fr}.card-grid,.flow{grid-template-columns:repeat(2,1fr)}.final-cta__inner{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.shell{width:min(100% - 28px,1120px)}.hero__grid{gap:36px;margin-top:40px}h1{font-size:3rem}.section{padding:68px 0}.card-grid,.flow{grid-template-columns:1fr}.actions{flex-direction:column}.final-cta .button{width:100%}}
  /* Brand alignment: navy foundation, with amber reserved for process cues. */
  :global(body){background:#f7f8fc;color:#17233b}.hero{background:radial-gradient(circle at 80% 10%,rgba(245,196,81,.18),transparent 32%),#0a1a33}.section--dark{background:#0c1e3c}.flow li{background:#0c1e3c}.final-cta{background:#122b52}.section--panel{background:#f0f3fa}.lead{color:#d7e0f2}.note{color:#91a3c4}.problem-card p,.flow p,.flow-note,.final-cta p{color:#b9c8e2}.card,.problem-card,.button{transition:transform .3s,box-shadow .3s,border-color .3s}.card:hover,.problem-card:hover{transform:translateY(-5px);box-shadow:0 18px 44px rgba(10,26,51,.12)}.button:hover{transform:translateY(-2px)}.button:focus-visible{outline:3px solid #a9bcff;outline-offset:3px}@media(prefers-reduced-motion:reduce){.card,.problem-card,.button{transition:none}.card:hover,.problem-card:hover,.button:hover{transform:none}}
</style>
