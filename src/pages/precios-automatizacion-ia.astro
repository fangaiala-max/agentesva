---
import BaseLayout from '../layouts/BaseLayout.astro';import SiteHeader from '../components/SiteHeader.astro';import SiteFooter from '../components/SiteFooter.astro';import Breadcrumb from '../components/Breadcrumb.astro';import{breadcrumbList,trail as buildTrail}from'../data/breadcrumbs';import{SERVICE_OFFER,PRICE_DISCLAIMER}from'../data/service-offer';import{jsonLdSerialize,ORG_ID,SITE,WEBSITE_ID}from'../data/schema';
const trail=buildTrail({name:'Precios de automatización con IA',url:'/precios-automatizacion-ia'});
const levels=[{...SERVICE_OFFER.diagnostic,fit:'Identificar prioridad y siguiente paso.',items:['Cuestionario de contexto','Revisión inicial','Recomendación']},{...SERVICE_OFFER.workshop,fit:'Convertir un proceso difuso en un plan.',items:['Mapa del proceso','Riesgos y controles','Alcance propuesto']},{...SERVICE_OFFER.scoped,fit:'Poner en marcha un primer flujo.',items:['Un flujo acotado','Pruebas y documentación','Formación']},{...SERVICE_OFFER.integrated,fit:'Conectar varias herramientas.',items:['Varias integraciones','Excepciones y alertas','Puesta en marcha']},{...SERVICE_OFFER.support,fit:'Mantener flujos activos.',items:['Incidencias','Ajustes acordados','Revisión de métricas']}];
const faqs=[['¿Incluye licencias?','No salvo que la propuesta lo indique. Licencias, APIs y mensajería se detallan por separado.'],['¿Qué cambia el precio?','Integraciones, datos, volumen, permisos, excepciones, riesgo, formación y soporte.'],['¿Puedo empezar pequeño?','Sí. Preferimos un flujo acotado y medible antes de ampliar.'],['¿El diagnóstico obliga a contratar?','No. Sirve para decidir si existe encaje y el siguiente paso razonable.']];
const jsonLd={'@context':'https://schema.org','@graph':[{'@type':'WebPage',name:'Precios de automatización con IA',url:`${SITE}/precios-automatizacion-ia/`,inLanguage:'es',isPartOf:{'@id':WEBSITE_ID}},{'@type':'Service',name:'Automatización con IA para PyMEs',provider:{'@id':ORG_ID},offers:levels.map(l=>({'@type':'Offer',name:l.name,description:`${l.price}. ${l.fit}`}))},{'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f[0],acceptedAnswer:{'@type':'Answer',text:f[1]}}))},breadcrumbList(trail)]};
---
<BaseLayout title="Precios de automatización con IA | AgentesVA" description="Rangos claros para diagnóstico, taller, implementación y soporte de automatizaciones con IA. Proyectos desde 1.500 €."><script type="application/ld+json" set:html={jsonLdSerialize(jsonLd)}/><SiteHeader/><main><section class="hero"><div class="shell"><Breadcrumb trail={trail}/><span class="eyebrow">Inversión transparente</span><h1>Cuánto cuesta automatizar un proceso con IA</h1><p>Publicamos rangos para valorar el encaje antes de hablar. El presupuesto final se confirma tras revisar proceso, datos, herramientas y riesgos.</p><a class="button" href="/diagnostico-automatizacion-ia/" data-track-event="service_cta_click" data-track-page-type="pricing" data-track-content-slug="precios-automatizacion-ia" data-track-service="general_consulting" data-track-cluster="general" data-track-placement="hero">Hacer el diagnóstico gratuito →</a></div></section><section class="section shell"><div class="levels">{levels.map(l=><article><span class="eyebrow">{l.name}</span><h2>{l.price}</h2><p>{l.fit}</p><ul>{l.items.map(i=><li>{i}</li>)}</ul></article>)}</div><p>{PRICE_DISCLAIMER} IVA y costes de terceros se detallan cuando corresponda.</p></section><section class="section panel"><div class="shell split"><div><span class="eyebrow">Qué cambia el presupuesto</span><h2>Complejidad real</h2><ul><li>Integraciones y permisos.</li><li>Calidad y volumen de datos.</li><li>Excepciones y controles humanos.</li><li>Riesgo, formación y soporte.</li></ul></div><div><span class="eyebrow">Buen encaje</span><h2>Un resultado medible</h2><p>Proceso recurrente, responsable, accesos legítimos y casos reales. No encaja todavía si el proceso cambia cada semana o nadie puede validarlo.</p></div></div></section><section class="section shell"><span class="eyebrow">Preguntas frecuentes</span><h2>Antes de pedir propuesta</h2>{faqs.map(f=><details><summary>{f[0]}</summary><p>{f[1]}</p></details>)}</section><section class="cta"><div class="shell"><h2>Encuentra el nivel adecuado</h2><a class="button" href="/diagnostico-automatizacion-ia/" data-track-event="service_cta_click" data-track-page-type="pricing" data-track-content-slug="precios-automatizacion-ia" data-track-service="general_consulting" data-track-cluster="general" data-track-placement="final_cta">Empezar diagnóstico →</a></div></section></main><SiteFooter/></BaseLayout>
<style>:global(body){background:#f7f8fc;color:#17233b}.shell{position:relative;z-index:1;width:min(1120px,calc(100% - 40px));margin:auto}.hero{position:relative;overflow:hidden;padding:28px 0 88px;background:radial-gradient(circle at 82% 12%,rgba(91,124,255,.26),transparent 34%),#0a1a33;color:#fff}.hero::after{position:absolute;inset:0;background-image:linear-gradient(rgba(169,188,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(169,188,255,.04) 1px,transparent 1px);background-size:52px 52px;mask-image:linear-gradient(black,transparent 90%);content:'';pointer-events:none}.hero p{max-width:760px;font-size:1.2rem;line-height:1.7;color:#d7e0f2}.eyebrow{display:block;margin:36px 0 12px;color:#5b7cff;font:700 .75rem 'JetBrains Mono Variable',monospace;text-transform:uppercase;letter-spacing:.12em}h1,h2{font-family:'DM Serif Display',serif;font-weight:400}h1{font-size:clamp(3rem,7vw,5.5rem);line-height:.98;text-wrap:balance}h2{font-size:2.1rem}.button{display:inline-block;margin-top:18px;padding:14px 20px;border-radius:6px;background:#5b7cff;color:#fff;font-weight:700;text-decoration:none;box-shadow:0 10px 30px rgba(91,124,255,.24);transition:transform .25s,box-shadow .25s}.button:hover{transform:translateY(-2px);box-shadow:0 15px 38px rgba(91,124,255,.34)}.button:focus-visible{outline:3px solid #a9bcff;outline-offset:3px}.section{padding:78px 0}.levels{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.levels article{position:relative;overflow:hidden;padding:22px;border:1px solid #dce3ef;border-radius:12px;background:#fff;transition:transform .3s,border-color .3s,box-shadow .3s}.levels article:hover{transform:translateY(-6px);border-color:#b7c6e4;box-shadow:0 20px 48px rgba(10,26,51,.12)}.levels article .eyebrow{margin:0}.levels p,.levels li,.split p,.split li,details p{color:#5d687c;line-height:1.55}.panel{background:#f0f3fa}.split{display:grid;grid-template-columns:1fr 1fr;gap:64px}.split .eyebrow{margin-top:0}details{border-top:1px solid #d5ddea}summary{padding:20px 0;font-weight:700;cursor:pointer}.cta{padding:60px 0;background:#122b52;color:#fff}.cta .shell{display:flex;align-items:center;justify-content:space-between}.cta .button{margin:0}@media(prefers-reduced-motion:reduce){.button,.levels article{transition:none}.button:hover,.levels article:hover{transform:none}}@media(max-width:900px){.levels{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.shell{width:calc(100% - 28px)}.levels,.split{grid-template-columns:1fr}.cta .shell{align-items:flex-start;flex-direction:column}.cta .button{width:100%;text-align:center}}</style>
