---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { bookingProviderFor, thanksPlanFor } from '../data/diagnostico-gracias';
import { verifyDiagnosticResultToken } from '../data/diagnostico-token';

export const prerender = false;

const token = Astro.url.searchParams.get('token') ?? '';
const signingSecret = process.env.DIAGNOSTIC_SIGNING_SECRET || '';
const verified = verifyDiagnosticResultToken(token, signingSecret);
const resultType = verified?.resultType ?? 'manual_review';
const cluster = verified?.cluster ?? 'general';
const bookingUrl = process.env.BOOKING_URL ?? '';
const plan = thanksPlanFor(resultType, cluster, verified ? bookingUrl : '');
const bookingProvider = plan.action.booking ? bookingProviderFor(plan.action.href) : undefined;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<BaseLayout
  title="Diagnóstico recibido | AgentesVA"
  description="Confirmación y próximos pasos de tu diagnóstico de automatización con IA."
  noindex={true}
>
  <SiteHeader />

  <main id="main-content" class="thanks-shell">
    <span class="success-mark" aria-hidden="true">✓</span>
    <p class="eyebrow">{plan.eyebrow}</p>
    <h1>{plan.title}</h1>
    <p class="description">{plan.description}</p>

    <section class="expectation" aria-labelledby="what-next">
      <h2 id="what-next">Qué ocurre ahora</h2>
      <p>{plan.expectation}</p>
    </section>

    <div class="actions">
      <a
        href={plan.action.href}
        class="button-primary shimmer"
        target={plan.action.booking ? '_blank' : undefined}
        rel={plan.action.booking ? 'noopener' : undefined}
        data-track-event={plan.action.booking ? 'booking_started' : undefined}
        data-track-booking-provider={bookingProvider}
        data-track-placement="diagnostic_result"
        data-track-cluster={plan.cluster}
        data-track-qualification-band={plan.resultType === 'qualified_call' ? 'high' : undefined}
      >{plan.action.label} →</a>
      <a href={plan.secondary.href} class="button-secondary">{plan.secondary.label}</a>
    </div>

    <p class="privacy-note">No compartimos tus respuestas con servicios de analítica. Si necesitas añadir contexto, responde al correo de seguimiento o escribe a <a href="mailto:hola@agentesva.com">hola@agentesva.com</a>.</p>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .thanks-shell { max-width: 680px; margin: 0 auto; padding: 64px 32px 90px; text-align: center; }
  .success-mark { display: inline-flex; align-items: center; justify-content: center; width: 58px; height: 58px; border: 1px solid var(--green); border-radius: 50%; background: color-mix(in srgb, var(--green) 11%, transparent); color: var(--green); font-size: 27px; }
  .eyebrow { margin: 22px 0 0; color: var(--accent); font: 11px var(--mono); letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin: 13px 0 0; color: #fff; font: 400 clamp(32px, 6vw, 48px)/1.06 var(--serif); letter-spacing: -.035em; text-wrap: balance; }
  .description { max-width: 36em; margin: 18px auto 0; color: var(--fg-3); font-size: 17px; line-height: 1.65; }
  .expectation { margin: 34px 0 0; padding: 24px; border: 1px solid var(--line-2); background: var(--panel); text-align: left; }
  .expectation h2 { margin: 0; color: #fff; font: 700 18px var(--sans); }
  .expectation p { margin: 9px 0 0; color: var(--fg-3); line-height: 1.6; }
  .actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .button-primary, .button-secondary { min-height: 46px; display: inline-flex; align-items: center; justify-content: center; padding: 11px 20px; border-radius: 3px; font: 600 14px var(--sans); text-decoration: none; }
  .button-primary { border: 1px solid var(--accent); background: var(--accent); color: var(--bg); }
  .button-secondary { border: 1px solid var(--line-2); color: var(--fg-2); }
  .privacy-note { margin: 28px auto 0; color: var(--fg-4); font-size: 12.5px; line-height: 1.55; }
  .privacy-note a { color: var(--accent); }
  @media (max-width: 560px) {
    .thanks-shell { padding: 44px 20px 70px; }
    .actions > * { width: 100%; }
  }
</style>
