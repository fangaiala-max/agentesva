---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EstudioFaq from '../../components/EstudioFaq.astro';
import EstudioFuentes from '../../components/EstudioFuentes.astro';
import GuideServiceCTA from '../../components/GuideServiceCTA.astro';
import GuideResourceCTA from '../../components/GuideResourceCTA.astro';
import { SITE, jsonLdSerialize, organization, person } from '../../data/schema';
import { breadcrumbList, crumbPath, SECCIONES, trail as buildTrail } from '../../data/breadcrumbs';

export async function getStaticPaths() {
  return (await getCollection('guias')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const canonical = `${SITE}/guias/${entry.id}/`;
const trail = buildTrail(SECCIONES.guias, { name: d.titulo, url: `/guias/${entry.id}` });
const jsonLd = {'@context':'https://schema.org','@graph':[
  {'@type':'Article',headline:d.titulo,description:d.descripcion,datePublished:d.fecha.toISOString(),dateModified:d.actualizado.toISOString(),inLanguage:'es',author:person,publisher:organization,mainEntityOfPage:canonical,url:canonical,image:d.portada ? `${SITE}${d.portada.src}` : `${SITE}/og.png`,citation:d.fuentes.map((f)=>({'@type':'CreativeWork',name:f.titulo,url:f.url}))},
  {'@type':'FAQPage',mainEntity:d.faq.map((f)=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},
  breadcrumbList(trail),
]};
const fecha = d.actualizado.toLocaleDateString('es-ES',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'});
---
<BaseLayout title={`${d.seoTitulo ?? d.titulo} | AgentesVA`} description={d.descripcion} ogType="article" ogImage={d.portada ? `${SITE}${d.portada.src}` : undefined}>
  <script type="application/ld+json" set:html={jsonLdSerialize(jsonLd)} />
  <SiteHeader />
  <main data-pagefind-body data-pagefind-filter="tipo:Guía" style="max-width:760px;margin:0 auto;padding:40px 32px 64px">
    <Breadcrumb trail={trail} />
    <p class="eyebrow">{d.tema}</p>
    <h1>{d.titulo}</h1>
    <p class="dek">{d.descripcion}</p>
    <p class="byline">Por Fernando Angulo · Actualizado el {fecha}</p>
    {d.portada && <figure class="guide-cover">
      <img src={d.portada.src} srcset={d.portada.srcMovil ? `${d.portada.srcMovil} 720w, ${d.portada.src} ${d.portada.width}w` : undefined} sizes={d.portada.srcMovil ? '(max-width: 760px) calc(100vw - 64px), 696px' : undefined} alt={d.portada.alt} width={d.portada.width} height={d.portada.height} loading="eager" decoding="async" />
      {d.portada.pie && <figcaption>{d.portada.pie}</figcaption>}
    </figure>}
    <section class="answer" aria-labelledby="respuesta-breve">
      <h2 id="respuesta-breve">Respuesta breve</h2><p>{d.respuesta}</p>
      <ul>{d.puntosClave.map((p)=><li>{p}</li>)}</ul>
    </section>
    {d.servicio && <GuideServiceCTA slug={entry.id} placement="after_answer" service={d.servicio} />}
    <article class="prose"><Content /></article>
    <EstudioFaq items={d.faq} />
    <EstudioFuentes items={d.fuentes} />
    <aside class="author-bio" aria-label="Sobre el autor">
      <p class="author-bio__label">Sobre el autor</p>
      <p><strong>Fernando Angulo</strong> es analista sénior de mercados y conferenciante internacional sobre IA y búsqueda, con ponencias en más de 35 países.</p>
    </aside>
    <section class="related"><h2>Siguiente lectura</h2><div>{d.relacionados.map((r)=><a href={crumbPath(r.href)}>{r.titulo} →</a>)}</div></section>
    {d.recurso && <GuideResourceCTA slug={entry.id} placement="final" resourceId={d.recurso.id} />}
    {d.servicio && <GuideServiceCTA slug={entry.id} placement="final" service={d.servicio} />}
    <a class="back" href="/guias/">← Todas las guías</a>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .eyebrow{font:600 11px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:24px 0 0}h1{font:400 clamp(30px,5.5vw,46px)/1.08 var(--serif);letter-spacing:-.03em;color:#fff;margin:10px 0 0}.dek{font-size:18px;line-height:1.55;color:var(--fg-3);margin:16px 0 0}.byline{font:11px var(--mono);color:var(--fg-5);margin:16px 0 0}.guide-cover{margin:30px 0 0}.guide-cover img{display:block;width:100%;height:auto;border:1px solid var(--line-2);border-radius:12px;background:var(--panel)}.guide-cover figcaption{margin-top:10px;color:var(--fg-5);font:11px/1.55 var(--mono)}.answer{margin-top:30px;padding:24px;background:var(--panel);border-left:3px solid var(--accent);border-radius:0 8px 8px 0}.answer h2,.related h2{font:600 18px var(--sans);color:#fff;margin:0}.answer p{color:var(--fg-2);line-height:1.65}.answer ul{color:var(--fg-3);line-height:1.6;padding-left:20px}.prose{margin-top:40px}.author-bio{margin-top:40px;padding:22px 24px;border:1px solid var(--line-2);border-radius:8px;background:var(--panel)}.author-bio__label{margin:0;color:var(--accent);font:600 10px var(--mono);letter-spacing:.12em;text-transform:uppercase}.author-bio p:last-child{margin:8px 0 0;color:var(--fg-3);font-size:16px;line-height:1.65}.author-bio strong{color:#fff}.related{margin-top:40px;border-top:1px solid var(--line);padding-top:24px}.related div{display:grid;gap:10px;margin-top:14px}.related a,.back{color:var(--accent);text-decoration:none}.back{display:inline-block;margin-top:34px;font:11px var(--mono);letter-spacing:.08em;text-transform:uppercase}
</style>
<script>import { initMotion } from '../../scripts/motion';document.addEventListener('astro:page-load',()=>initMotion());</script>
