---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { PROMPTS } from '../../data/biblioteca/prompts';
import { PROMPT_LANDINGS, type PromptLanding } from '../../data/prompt-landings';
import { breadcrumbList, SECCIONES, trail } from '../../data/breadcrumbs';
import { jsonLdSerialize, SITE } from '../../data/schema';

export function getStaticPaths() {
  return PROMPT_LANDINGS.map((landing) => ({ params: { slug: landing.slug }, props: { landing } }));
}

const { landing } = Astro.props as { landing: PromptLanding };
const promptById = new Map(PROMPTS.map((prompt) => [prompt.id, prompt]));
const prompts = landing.promptIds.map((id) => promptById.get(id)).filter(Boolean);
const related = PROMPT_LANDINGS.filter((item) => item.slug !== landing.slug).slice(0, 3);
const canonical = `${SITE}/prompts/${landing.slug}/`;
const crumbs = trail(SECCIONES.prompts, { name: landing.title, url: `/prompts/${landing.slug}` });
const teaser = (body = '') => body.match(/Tarea:\s*([^\n]+)/)?.[1] ?? body.split('\n')[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: landing.title,
      description: landing.description,
      url: canonical,
      inLanguage: 'es',
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: prompts.length,
        itemListElement: prompts.map((prompt, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: prompt?.titulo,
        })),
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: landing.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
    breadcrumbList(crumbs),
  ],
};
---

<BaseLayout title={landing.seoTitle} description={landing.description} canonical={canonical}>
  <script type="application/ld+json" set:html={jsonLdSerialize(jsonLd)} />
  <SiteHeader />

  <main id="main-content" data-pagefind-body style="max-width: 980px; margin: 0 auto; padding: 40px 32px 72px;">
    <Breadcrumb trail={crumbs} />

    <header style="max-width: 760px; margin-top: 24px;">
      <span style="font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);">{landing.eyebrow}</span>
      <h1 style="font-family: var(--serif); font-weight: 400; font-size: clamp(34px, 7vw, 56px); line-height: 1.04; letter-spacing: -0.035em; color: #fff; margin: 12px 0 0;">{landing.title}</h1>
      <p style="font-size: 18px; line-height: 1.65; color: var(--fg-3); margin: 18px 0 0;">{landing.intro}</p>
      <p style="font-family: var(--mono); font-size: 11px; color: var(--fg-5); margin: 16px 0 0;">{prompts.length} plantillas · Copia y personaliza los campos entre corchetes</p>
    </header>

    <section aria-label="Plantillas de prompts" style="display: flex; flex-direction: column; gap: 20px; margin-top: 42px;">
      {prompts.map((prompt, index) => prompt && (
        <article class="spotlight" style="border: 1px solid var(--line); background: var(--panel); border-radius: 10px; padding: 24px;">
          <span style="font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; color: var(--accent);">{String(index + 1).padStart(2, '0')}</span>
          <h2 style="font-family: var(--serif); font-weight: 400; font-size: 24px; line-height: 1.18; color: #fff; margin: 10px 0 0;">{prompt.titulo}</h2>
          <p style="font-size: 16px; line-height: 1.6; color: var(--fg-3); margin: 10px 0 0;">{teaser(prompt.cuerpo)}</p>
          <details style="margin-top: 16px;">
            <summary style="cursor: pointer; font-family: var(--mono); font-size: 11px; color: var(--accent);">Ver prompt completo</summary>
            <pre style="font-family: var(--mono); font-size: 12.5px; line-height: 1.65; color: var(--fg-2); white-space: pre-wrap; word-break: break-word; margin: 14px 0 0; border-top: 1px solid var(--line); padding-top: 16px;">{prompt.cuerpo}</pre>
          </details>
          <button type="button" class="bib-copy shimmer" data-copy={prompt.cuerpo} style="display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; font-family: var(--sans); font-weight: 700; font-size: 13px; color: var(--bg); background: var(--accent); border: none; border-radius: 2px; padding: 10px 16px; cursor: pointer;">
            <span class="bib-copy-label">Copiar prompt</span>
          </button>
        </article>
      ))}
    </section>

    <section style="margin-top: 48px; border-top: 1px solid var(--line); padding-top: 30px;">
      <h2 style="font-family: var(--sans); font-size: 24px; color: #fff; margin: 0;">Preguntas frecuentes</h2>
      <div style="display: grid; gap: 22px; margin-top: 22px;">
        {landing.faqs.map((faq) => (
          <div>
            <h3 style="font-family: var(--sans); font-size: 16px; color: #fff; margin: 0;">{faq.q}</h3>
            <p style="font-size: 16px; line-height: 1.65; color: var(--fg-3); margin: 8px 0 0;">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <aside style="margin-top: 48px; border: 1px solid var(--line); background: var(--panel-2); border-radius: 10px; padding: 26px;">
      <h2 style="font-family: var(--sans); font-size: 20px; color: #fff; margin: 0;">Más colecciones</h2>
      <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px;">
        {related.map((item) => <a href={`/prompts/${item.slug}`} class="lift" style="font-family: var(--mono); font-size: 11px; color: var(--fg-2); border: 1px solid var(--line-2); border-radius: 30px; padding: 9px 14px; text-decoration: none;">{item.title}</a>)}
        <a href="/recurso/biblioteca-ia" class="lift" style="font-family: var(--mono); font-size: 11px; color: var(--accent); border: 1px solid var(--accent); border-radius: 30px; padding: 9px 14px; text-decoration: none;">Biblioteca completa</a>
      </div>
    </aside>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  import { initBibliotecaCopy } from '../../scripts/biblioteca';
  document.addEventListener('astro:page-load', () => initBibliotecaCopy());
</script>
