---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import translations from '../../i18n/tools.json';
import '../../styles/english.css';
export async function getStaticPaths(){return (await getCollection('tools')).map(tool=>({params:{slug:tool.id},props:{tool}}));}
const {tool}=Astro.props;
const copy=translations[tool.id as keyof typeof translations];
const name=tool.data.name.replace(/ IA$/, ' AI');
const cat=(await getCollection('categories')).find(c=>c.data.nombre===tool.data.cat);
---
<BaseLayout title={`${name}: uses and getting started | AgentesVA`} description={copy.description}>
<SiteHeader/><main id="main-content" class="en-page" data-pagefind-body><section class="en-hero"><div class="en-shell"><nav class="en-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/tools/">AI tools</a><span>/</span><span aria-current="page">{name}</span></nav><div class="en-hero-grid"><div><p class="en-kicker">A practical tool profile</p><h1>{name}</h1><p class="en-lead">{copy.description}</p><div class="en-actions"><a href={tool.data.url} class="en-button" target="_blank" rel="noopener noreferrer">Visit {name}<span class="sr-only"> (opens in a new tab)</span></a><a href="/tools/" class="en-button en-button--quiet">Compare more tools</a></div><p class="en-note">Check the provider for current availability, plan limits, and pricing.</p></div><aside class="en-margin-note"><span class="en-tool-icon" aria-hidden="true">{name.slice(0,2)}</span><h2>Start with a real task.</h2><p>Use a representative example and review the result before including this tool in your workflow.</p></aside></div></div></section><section class="en-section en-shell en-split"><div><h2>What it helps with.</h2><ul class="en-checklist">{copy.features.map(f=><li>{f}</li>)}</ul></div><div><h2>How to get started.</h2><ol class="en-checklist">{copy.steps.map(s=><li>{s}</li>)}</ol></div></section><section class="en-close"><div class="en-shell en-close-inner"><div><h2>Need to connect it to your process?</h2><p>Find out where automation could make a useful difference.</p></div><a href="/assessment/" class="en-button en-button--white">Assess my process</a></div></section>{cat&&<div class="en-section en-shell"><a href={`/tools/category/${cat.id}/`} class="en-button">Explore related tools</a></div>}</main><SiteFooter hideNewsletter/>
</BaseLayout>
