---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import translations from '../../i18n/tools.json';
import '../../styles/english.css';
import '../../styles/tool-showcase.css';
import ToolIdentity from '../../components/english/ToolIdentity.astro';
import ToolVisual from '../../components/english/ToolVisual.astro';
import {affiliateHref} from '../../data/ir';
export async function getStaticPaths(){return (await getCollection('tools')).map(tool=>({params:{slug:tool.id},props:{tool}}));}
const {tool}=Astro.props;
const copy=translations[tool.id as keyof typeof translations];
const name=tool.data.name.replace(/ IA$/, ' AI');
const cat=(await getCollection('categories')).find(c=>c.data.nombre===tool.data.cat);
---
<BaseLayout title={`${name}: uses and getting started | AgentesVA`} description={copy.description}>
<SiteHeader/><main id="main-content" class="en-page tool-showcase-profile" data-pagefind-body><section class="en-hero"><div class="en-shell"><nav class="en-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/tools/">AI tools</a><span>/</span><span aria-current="page">{name}</span></nav><div class="en-hero-grid"><div><div class="profile-identity"><ToolIdentity slug={tool.id} name={name}/><span>A practical tool profile</span></div><h1>{name}</h1><p class="en-lead">{copy.description}</p><div class="en-actions"><a href={affiliateHref(tool.id,"en-profile-hero")} data-track-event="affiliate_click" data-track-slug={tool.id} data-track-src="en-profile-hero" data-track-has-affiliate={tool.data.affiliateUrl?"1":"0"} class="en-button" target="_blank" rel={tool.data.affiliateUrl?"sponsored nofollow noopener noreferrer":"noopener noreferrer"}>Visit {name}<span class="sr-only"> (opens in a new tab)</span></a><a href="/tools/" class="en-button en-button--quiet">Compare more tools</a></div><p class="en-note">Check the provider for current availability, plan limits, and pricing.</p></div><aside class="profile-visual"><ToolVisual slug={tool.id} features={copy.features}/><p>Illustrative workflow, not a product screenshot.</p></aside></div></div></section><section class="en-section en-shell" data-profile-tabs><div class="profile-tabs" role="tablist" aria-label="Explore this tool"><button type="button" role="tab" id="tab-overview" aria-controls="panel-overview" aria-selected="true">Overview</button><button type="button" role="tab" id="tab-capabilities" aria-controls="panel-capabilities" aria-selected="false">Capabilities</button><button type="button" role="tab" id="tab-start" aria-controls="panel-start" aria-selected="false">Getting started</button></div><div class="profile-panel" id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0"><h2>Start with a useful task.</h2><p>{copy.description}</p><p>Try a representative example, check the result, and decide whether it fits the way your team works.</p><p>{tool.data.affiliateUrl?'We may earn a commission if you use our provider link.':'This profile links to the official provider. Inclusion does not imply a commercial partnership.'}</p></div><div class="profile-panel" id="panel-capabilities" role="tabpanel" aria-labelledby="tab-capabilities" tabindex="0"><h2>What it helps with.</h2><ul>{copy.features.map(f=><li>{f}</li>)}</ul></div><div class="profile-panel" id="panel-start" role="tabpanel" aria-labelledby="tab-start" tabindex="0"><h2>Your first useful result.</h2><ol>{copy.steps.map(s=><li>{s}</li>)}</ol></div></section><section class="en-close"><div class="en-shell en-close-inner"><div><h2>Need to connect it to your process?</h2><p>Find out where automation could make a useful difference.</p></div><a href="/assessment/" class="en-button en-button--white">Assess my process</a></div></section>{cat&&<div class="en-section en-shell"><a href={`/tools/category/${cat.id}/`} class="en-button">Explore related tools</a></div>}</main><SiteFooter hideNewsletter/>
</BaseLayout>

<script>import {initToolShowcase} from "../../scripts/tool-showcase";document.addEventListener("astro:page-load",initToolShowcase);</script>
