---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { breadcrumbList, SECCIONES, trail } from '../data/breadcrumbs';
import { jsonLdSerialize, SITE } from '../data/schema';

const canonical = `${SITE}/generador-de-prompts/`;
const faqs = [
  { q: '¿Qué es un generador de prompts?', a: 'Es una herramienta que convierte el contexto y el objetivo que introduces en una instrucción estructurada para un asistente de IA.' },
  { q: '¿Funciona con ChatGPT, Claude y Gemini?', a: 'Sí. El generador usa instrucciones de texto estándar compatibles con los principales asistentes de IA.' },
  { q: '¿AgentesVA guarda lo que escribo?', a: 'No. El prompt se construye dentro de tu navegador y el formulario no envía su contenido a un servidor.' },
];
const crumbs = trail(
  SECCIONES.prompts,
  { name: 'Generador de prompts', url: '/generador-de-prompts' },
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Generador de prompts gratis',
      description: 'Herramienta gratuita para crear prompts estructurados para ChatGPT, Claude y Gemini.',
      url: canonical,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      inLanguage: 'es',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
    breadcrumbList(crumbs),
  ],
};

const fieldStyle = 'width: 100%; box-sizing: border-box; background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 6px; color: #fff; font-family: var(--sans); font-size: 16px; line-height: 1.5; padding: 12px 14px; resize: vertical;';
---

<BaseLayout
  title="Generador de prompts gratis para ChatGPT y otras IA | AgentesVA"
  description="Crea un prompt profesional para ChatGPT, Claude o Gemini. Define rol, contexto, tarea, restricciones y formato. Gratis y sin registro."
  canonical={canonical}
>
  <script type="application/ld+json" set:html={jsonLdSerialize(jsonLd)} />
  <SiteHeader />

  <main id="main-content" data-pagefind-body style="max-width: 1080px; margin: 0 auto; padding: 40px 32px 72px;">
    <Breadcrumb trail={crumbs} />

    <header style="max-width: 780px; margin-top: 24px;">
      <span style="font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);">Herramienta gratuita · Sin registro</span>
      <h1 style="font-family: var(--serif); font-weight: 400; font-size: clamp(36px, 7vw, 58px); line-height: 1.02; letter-spacing: -0.035em; color: #fff; margin: 12px 0 0;">Generador de prompts</h1>
      <p style="font-size: 18px; line-height: 1.65; color: var(--fg-3); margin: 18px 0 0;">Convierte una idea imprecisa en un prompt claro para ChatGPT, Claude o Gemini. Todo se genera en tu navegador: no enviamos ni guardamos lo que escribes.</p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; align-items: start; margin-top: 38px;">
      <form id="prompt-generator-form" style="display: grid; gap: 18px; border: 1px solid var(--line); background: var(--panel); border-radius: 10px; padding: 24px;">
        <label style="display: grid; gap: 7px; font-size: 14px; color: #fff;">
          Rol de la IA
          <input name="role" value="Eres un especialista con experiencia en [área]" style={fieldStyle} />
          <small style="color: var(--fg-5);">Ejemplo: consultor SEO, responsable financiero o copywriter B2B.</small>
        </label>
        <label style="display: grid; gap: 7px; font-size: 14px; color: #fff;">
          Contexto
          <textarea name="context" rows="3" placeholder="Mi empresa vende [producto] a [audiencia] y necesitamos..." style={fieldStyle}></textarea>
        </label>
        <label style="display: grid; gap: 7px; font-size: 14px; color: #fff;">
          Tarea
          <textarea name="task" rows="3" placeholder="Analiza, redacta, compara o crea..." required style={fieldStyle}></textarea>
        </label>
        <label style="display: grid; gap: 7px; font-size: 14px; color: #fff;">
          Restricciones
          <textarea name="restrictions" rows="3" placeholder="No inventes datos. Máximo 300 palabras. Español neutro..." style={fieldStyle}></textarea>
        </label>
        <label style="display: grid; gap: 7px; font-size: 14px; color: #fff;">
          Formato de salida
          <input name="format" placeholder="Tabla, lista, email, JSON, plan por pasos..." style={fieldStyle} />
        </label>
        <button type="submit" class="shimmer" style="background: var(--accent); color: var(--bg); border: none; border-radius: 2px; padding: 13px 20px; font-family: var(--sans); font-weight: 700; font-size: 14px; cursor: pointer;">Generar prompt</button>
      </form>

      <section aria-live="polite" style="position: sticky; top: 110px; border: 1px solid var(--line); background: var(--panel-2); border-radius: 10px; padding: 24px;">
        <h2 style="font-family: var(--sans); font-size: 20px; color: #fff; margin: 0;">Tu prompt</h2>
        <p id="prompt-generator-status" style="font-family: var(--mono); font-size: 10px; color: var(--fg-5); margin: 8px 0 0;">Describe la tarea para generar el prompt.</p>
        <textarea id="prompt-generator-output" readonly rows="19" aria-label="Prompt generado" style={`${fieldStyle} margin-top: 16px; font-family: var(--mono); font-size: 12.5px;`}></textarea>
        <button id="prompt-generator-copy" type="button" disabled class="lift" style="margin-top: 12px; background: transparent; color: var(--accent); border: 1px solid var(--accent); border-radius: 2px; padding: 10px 16px; font-family: var(--sans); font-weight: 700; font-size: 13px; cursor: pointer;">Copiar prompt</button>
      </section>
    </div>

    <section style="max-width: 760px; margin-top: 52px; border-top: 1px solid var(--line); padding-top: 30px;">
      <h2 style="font-family: var(--sans); font-size: 25px; color: #fff; margin: 0;">Cómo escribir un buen prompt</h2>
      <p style="font-size: 16px; line-height: 1.7; color: var(--fg-3);">Un prompt útil dice quién debe actuar, qué información necesita, qué tarea debe completar, qué límites debe respetar y cómo quieres recibir el resultado. El generador organiza esos cinco elementos; tú sigues siendo responsable de aportar datos reales y revisar la respuesta.</p>
      <h2 style="font-family: var(--sans); font-size: 22px; color: #fff; margin: 32px 0 0;">Preguntas frecuentes</h2>
      <div style="display: grid; gap: 20px; margin-top: 18px;">
        {faqs.map((faq) => (
          <div><h3 style="font-size: 16px; color: #fff; margin: 0;">{faq.q}</h3><p style="font-size: 16px; line-height: 1.65; color: var(--fg-3); margin: 7px 0 0;">{faq.a}</p></div>
        ))}
      </div>
      <p style="margin-top: 28px;"><a href="/prompts/chatgpt" style="font-family: var(--mono); font-size: 12px; color: var(--accent);">Ver ejemplos de prompts para ChatGPT →</a></p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  import { initPromptGenerator } from '../scripts/prompt-generator';
  document.addEventListener('astro:page-load', () => initPromptGenerator());
</script>
