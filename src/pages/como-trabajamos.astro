---
import BaseLayout from '../layouts/BaseLayout.astro';import SiteHeader from '../components/SiteHeader.astro';import SiteFooter from '../components/SiteFooter.astro';import Breadcrumb from '../components/Breadcrumb.astro';import{breadcrumbList,trail as buildTrail}from'../data/breadcrumbs';import{jsonLdSerialize,ORG_ID,SITE,WEBSITE_ID}from'../data/schema';
const trail=buildTrail({name:'Cómo trabajamos',url:'/como-trabajamos'});const phases=[['01','Diagnóstico','Entendemos proceso, frecuencia, datos, herramientas y riesgo.'],['02','Diseño','Definimos entradas, salidas, responsables, excepciones y éxito.'],['03','Implementación','Conectamos el flujo por etapas y registramos decisiones.'],['04','Pruebas','Probamos casos normales, incompletos y erróneos.'],['05','Puesta en marcha','Formamos, documentamos y activamos con monitorización.'],['06','Optimización','Revisamos incidencias y métricas antes de ampliar.']];const faqs=[['¿Quién participa?','Una persona responsable, quienes ejecutan el proceso y alguien con acceso a las herramientas.'],['¿Qué debemos aportar?','Ejemplos reales, reglas, accesos controlados y disponibilidad para validar.'],['¿Cuándo se confirma precio y plazo?','Después de conocer integraciones, datos, excepciones y riesgos.'],['¿Y si el proceso no está preparado?','Recomendamos aclararlo o medirlo antes de implementar.']];const jsonLd={'@context':'https://schema.org','@graph':[{'@type':'WebPage',name:'Cómo trabajamos automatizaciones con IA',url:`${SITE}/como-trabajamos/`,inLanguage:'es',isPartOf:{'@id':WEBSITE_ID}},{'@type':'Service',name:'Diseño e implementación de automatizaciones con IA',provider:{'@id':ORG_ID}},{'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f[0],acceptedAnswer:{'@type':'Answer',text:f[1]}}))},breadcrumbList(trail)]};
---
<BaseLayout title="Cómo trabajamos automatizaciones con IA | AgentesVA" description="Del diagnóstico a la puesta en marcha: proceso, responsabilidades, pruebas y entregables para automatizar con control."><script type="application/ld+json" set:html={jsonLdSerialize(jsonLd)}/><SiteHeader/><main><section class="hero"><div class="shell"><Breadcrumb trail={trail}/><span class="eyebrow">Proceso verificable</span><h1>Automatizar sin perder el control</h1><p>Reducimos incertidumbre en cada fase: entendemos, diseñamos, probamos y ponemos en marcha con una persona responsable.</p><a class="button" href="/diagnostico-automatizacion-ia/" data-track-event="service_cta_click" data-track-page-type="methodology" data-track-content-slug="como-trabajamos" data-track-service="general_consulting" data-track-cluster="general" data-track-placement="hero">Empezar por el diagnóstico →</a></div></section><section class="section shell"><span class="eyebrow">Seis fases</span><h2>De una fricción a un flujo operativo</h2><ol class="phases">{phases.map(p=><li><span>{p[0]}</span><div><h3>{p[1]}</h3><p>{p[2]}</p></div></li>)}</ol></section><section class="section panel"><div class="shell split"><div><span class="eyebrow">Tu responsabilidad</span><h2>Contexto y decisiones</h2><ul><li>Nombrar responsable.</li><li>Facilitar casos y accesos legítimos.</li><li>Validar reglas y pruebas.</li></ul></div><div><span class="eyebrow">Nuestra responsabilidad</span><h2>Ejecución y transparencia</h2><ul><li>Explicar alcance, riesgos y costes.</li><li>Construir controles y trazabilidad.</li><li>Probar, documentar y formar.</li></ul></div></div></section><section class="section shell"><span class="eyebrow">Límites</span><h2>Cuándo seguimos y cuándo paramos</h2><div class="decisions"><article><h3>Seguimos</h3><p>Proceso recurrente, fuente fiable, responsable y resultado medible.</p></article><article><h3>Aclaramos primero</h3><p>Reglas cambiantes, datos insuficientes o excepciones sin dueño.</p></article><article><h3>No automatizamos</h3><p>Información inventada, permisos incumplidos o decisiones sensibles sin control.</p></article></div></section><section class="section shell"><span class="eyebrow">Preguntas frecuentes</span><h2>Antes de empezar</h2>{faqs.map(f=><details><summary>{f[0]}</summary><p>{f[1]}</p></details>)}</section><section class="cta"><div class="shell"><h2>Cuéntanos qué proceso quieres mejorar</h2><a class="button" href="/diagnostico-automatizacion-ia/" data-track-event="service_cta_click" data-track-page-type="methodology" data-track-content-slug="como-trabajamos" data-track-service="general_consulting" data-track-cluster="general" data-track-placement="final_cta">Hacer diagnóstico →</a></div></section></main><SiteFooter/></BaseLayout>
<style>:global(body){background:#f7f8fc;color:#17233b}.shell{position:relative;z-index:1;width:min(1080px,calc(100% - 40px));margin:auto}.hero{position:relative;overflow:hidden;padding:28px 0 88px;background:radial-gradient(circle at 82% 12%,rgba(91,124,255,.26),transparent 34%),#0a1a33;color:#fff}.hero::after{position:absolute;inset:0;background-image:linear-gradient(rgba(169,188,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(169,188,255,.04) 1px,transparent 1px);background-size:52px 52px;mask-image:linear-gradient(black,transparent 90%);content:'';pointer-events:none}.hero p{max-width:760px;font-size:1.2rem;line-height:1.7;color:#d7e0f2}.eyebrow{display:block;margin:36px 0 12px;color:#5b7cff;font:700 .75rem 'JetBrains Mono Variable',monospace;text-transform:uppercase;letter-spacing:.12em}h1,h2,h3{font-family:'DM Serif Display',serif;font-weight:400}h1{font-size:clamp(3rem,7vw,5.5rem);line-height:.98;text-wrap:balance}h2{font-size:clamp(2.2rem,4vw,3.4rem)}h3{font-size:1.5rem}.button{display:inline-block;margin-top:18px;padding:14px 20px;border-radius:6px;background:#5b7cff;color:#fff;font-weight:700;text-decoration:none;box-shadow:0 10px 30px rgba(91,124,255,.24);transition:transform .25s,box-shadow .25s}.button:hover{transform:translateY(-2px);box-shadow:0 15px 38px rgba(91,124,255,.34)}.button:focus-visible{outline:3px solid #a9bcff;outline-offset:3px}.section{padding:78px 0}.phases{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:0;list-style:none}.phases li{display:flex;gap:20px;padding:26px;border:1px solid #dce3ef;border-radius:12px;background:#fff;transition:transform .3s,border-color .3s,box-shadow .3s}.phases li:hover,.decisions article:hover{transform:translateY(-5px);border-color:#b7c6e4;box-shadow:0 18px 44px rgba(10,26,51,.11)}.phases span{color:#5b7cff;font:700 .8rem 'JetBrains Mono Variable',monospace}.phases h3{margin:0}.phases p,.split li,.decisions p,details p{color:#5d687c;line-height:1.6}.panel{background:#f0f3fa}.split{display:grid;grid-template-columns:1fr 1fr;gap:64px}.split .eyebrow{margin-top:0}.decisions{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.decisions article{padding:24px;border:1px solid #dce3ef;border-radius:12px;background:#fff;transition:transform .3s,border-color .3s,box-shadow .3s}details{border-top:1px solid #d5ddea}summary{padding:20px 0;font-weight:700;cursor:pointer}.cta{padding:60px 0;background:#122b52;color:#fff}.cta .shell{display:flex;align-items:center;justify-content:space-between}.cta .button{margin:0}@media(prefers-reduced-motion:reduce){.button,.phases li,.decisions article{transition:none}.button:hover,.phases li:hover,.decisions article:hover{transform:none}}@media(max-width:700px){.shell{width:calc(100% - 28px)}.phases,.split,.decisions{grid-template-columns:1fr}.cta .shell{align-items:flex-start;flex-direction:column}.cta .button{width:100%;text-align:center}}</style>
