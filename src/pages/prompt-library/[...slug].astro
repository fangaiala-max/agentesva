---
import BaseLayout from '../../layouts/BaseLayout.astro';import SiteHeader from '../../components/SiteHeader.astro';import SiteFooter from '../../components/SiteFooter.astro';import {promptGroups,completePrompt} from '../../i18n/prompts';import '../../styles/english.css';
export function getStaticPaths(){return [{params:{slug:undefined}},...promptGroups.map(g=>({params:{slug:g.slug},props:{group:g}}))];}
const {group}=Astro.props;
const groups=group?[group]:promptGroups;
---
<BaseLayout title={`${group?group.title+' prompts':'Business prompt library'} | AgentesVA`} description="Practical English prompts for everyday work, marketing, sales, customer support, and small business operations. Copy and adapt them to your task."><SiteHeader/><main id="main-content" class="en-page" data-pagefind-body><section class="en-hero"><div class="en-shell"><nav class="en-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/prompt-library/">Prompt library</a>{group&&<><span>/</span><span>{group.title}</span></>}</nav><div class="en-hero-grid"><div><p class="en-kicker">Ready to adapt</p><h1>{group?`${group.title}. A better starting brief.`:'Better context. More useful answers.'}</h1><p class="en-lead">Replace the bracketed fields with your information, paste into your assistant, and review the result. {group?group.description:'Explore 30 practical English prompts across six areas of work.'}</p><a class="en-button" href="/prompt-builder/">Build a prompt for your task</a></div></div></div></section><div class="en-section en-shell"><nav class="prompt-nav" aria-label="Prompt categories">{promptGroups.map(g=><a href={`/prompt-library/${g.slug}/`} aria-current={group?.slug===g.slug?'page':undefined}>{g.title}</a>)}</nav>{groups.map(g=><section class="prompt-group"><h2>{g.title}</h2><p>{g.description}</p>{g.tasks.map(([title,task],i)=><details class="prompt-detail"><summary>{title}</summary><div><pre id={`prompt-${g.slug}-${i}`}>{completePrompt(task)}</pre><button type="button" class="en-button" data-copy-prompt={`prompt-${g.slug}-${i}`}>Copy prompt</button><span role="status" data-copy-status></span></div></details>)}</section>)}</div></main><SiteFooter hideNewsletter/></BaseLayout>
<style>.prompt-nav{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:45px}.prompt-nav a{padding:12px 16px;border:1px solid #bdc8df;border-radius:8px;text-decoration:none;color:#2343d9;font-size:14px}.prompt-nav a[aria-current]{background:#e2eaff}.prompt-group{margin-bottom:55px}.prompt-group h2{font-size:32px}.prompt-detail{border-top:1px solid #cbd2e0}.prompt-detail:last-child{border-bottom:1px solid #cbd2e0}.prompt-detail summary{padding:22px 0;cursor:pointer;font-size:19px;font-weight:550}.prompt-detail>div{padding-bottom:25px}.prompt-detail pre{white-space:pre-wrap;overflow-wrap:anywhere;font:16px/1.8 var(--sans);padding:25px;background:white;border:1px solid #d7deec;border-radius:10px;color:#17233b}.prompt-detail [role=status]{margin-left:16px;font-size:14px;color:#375140}</style>
<script>import {initCopyPrompts} from '../../scripts/copy-prompts';document.addEventListener('astro:page-load',initCopyPrompts);</script>
