---
import BaseLayout from '../layouts/BaseLayout.astro';import SiteHeader from '../components/SiteHeader.astro';import SiteFooter from '../components/SiteFooter.astro';import '../styles/english.css';
---
<BaseLayout title="The AgentesVA newsletter | AgentesVA" description="Subscribe to our Spanish-language newsletter for practical AI ideas and a free resource pack."><SiteHeader/><main id="main-content" class="en-page"><section class="en-hero"><div class="en-shell"><p class="en-kicker">One useful idea each week</p><h1 style="font-size:clamp(40px,6vw,68px);font-weight:550;max-width:18ch">Practical AI, in your inbox.</h1><p class="en-lead">Our newsletter and welcome resources are currently in Spanish. Subscribe for practical ideas and the 30-prompt pack plus customer support skill.</p></div></section><section class="en-section en-shell en-article" data-subscribe-root><form data-subscribe data-list="newsletter" data-source="english_newsletter" novalidate><label for="updates-email">Your email address</label><input id="updates-email" name="email" type="email" autocomplete="email" required data-subscribe-email placeholder="you@company.com"/><div class="sr-only" aria-hidden="true"><label>Leave empty<input name="company" type="text" tabindex="-1" autocomplete="off" data-subscribe-hp/></label></div><label class="updates-consent"><input type="checkbox" required data-subscribe-consent/><span>I agree to receive the Spanish-language AgentesVA newsletter and accept the <a href="/privacy/">privacy policy</a>.</span></label><button type="submit" class="en-button" data-subscribe-submit>Subscribe to the Spanish edition</button></form><div data-subscribe-success hidden role="status"><h2 data-subscribe-success-title>Check your email.</h2><p data-subscribe-success-copy>Confirm your subscription using the email we sent. After confirming, you will receive the Spanish resource pack.</p></div><p data-subscribe-error hidden role="alert"></p><p>You can unsubscribe using the link in any newsletter.</p></section></main><SiteFooter hideNewsletter/></BaseLayout>
<style>form{display:grid;gap:18px}#updates-email{width:100%;background:#fff;color:#17233b;border:1px solid #aebbd3;border-radius:8px;padding:15px;font-size:16px}.updates-consent{display:flex;align-items:start;gap:12px;font-size:14px;line-height:1.7}.updates-consent input{margin-top:6px}button{justify-self:start}[role=alert]{color:#a72525}</style>
<script>import {initSubscribe} from '../scripts/subscribe';document.addEventListener('astro:page-load',initSubscribe);</script>
