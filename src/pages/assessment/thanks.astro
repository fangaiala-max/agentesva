---
import BaseLayout from '../../layouts/BaseLayout.astro';import SiteHeader from '../../components/SiteHeader.astro';import SiteFooter from '../../components/SiteFooter.astro';import {verifyDiagnosticResultToken} from '../../data/diagnostico-token';import {thanksPlanFor} from '../../data/diagnostico-gracias';import {englishPath} from '../../i18n/routes';import '../../styles/english.css';
export const prerender=false;
const verified=verifyDiagnosticResultToken(Astro.url.searchParams.get('token')??'',process.env.DIAGNOSTIC_SIGNING_SECRET??'');
const resultType=verified?.resultType??'manual_review';
const plan=thanksPlanFor(resultType,verified?.cluster??'general',verified?(process.env.BOOKING_URL??''):'');
const copy={qualified_call:['Your process looks ready for an implementation review.','We will review the process, its dependencies, and scope before recommending a specific solution.','We will reply on the next business day. A booked conversation helps validate the workflow and access requirements.'],paid_workshop:['The next step is to define the scope.','There is an opportunity to explore. First, map the process, validate the data, and decide which part is worth automating.','We will reply on the next business day with the workshop fit and the information needed to prepare.'],self_serve_resources:['Start with a small, measurable opportunity.','You do not need to hire an implementation team yet. Measure the repetitive work and identify one case with visible impact.','Use the guide now and reply to our email if you would like to discuss your chosen priority.'],manual_review:['We will review the case before recommending automation.','The data, decisions, or controls involved need human oversight. A sensitive decision needs clear boundaries.','We will reply on the next business day with what can be explored and what needs human review.']}[resultType];
Astro.response.headers.set('Cache-Control','no-store');
---
<BaseLayout title="Assessment: next steps | AgentesVA" description="Confirmation and next steps for your automation assessment." noindex><SiteHeader/><main id="main-content" class="en-page"><section class="en-section en-shell en-article"><p class="en-kicker">{verified?'Assessment received':'Assessment follow-up'}</p><h1 style="font-size:clamp(36px,5vw,58px);font-weight:550">{verified?copy[0]:'Find your assessment’s next step.'}</h1><p>{verified?copy[1]:'This link could not verify a submitted assessment. You can return to the assessment or contact us if you have already sent your answers.'}</p>{verified&&<><h2>What happens now</h2><p>{copy[2]}</p></>}<div class="en-actions"><a class="en-button" href={verified?englishPath(plan.action.href):'/assessment/'} target={plan.action.booking?'_blank':undefined} rel={plan.action.booking?'noopener noreferrer':undefined}>{!verified?'Return to the assessment':plan.action.booking?'Book a conversation':plan.action.href.startsWith('mailto:')?'Email AgentesVA':resultType==='self_serve_resources'?'Choose your first workflow':'See how we work'}</a><a class="en-button" href="/pricing/">Explore pricing</a></div><p>Your answers are not shared with analytics services. To add context, email <a href="mailto:hola@agentesva.com">hola@agentesva.com</a>.</p></section></main><SiteFooter hideNewsletter/></BaseLayout>
