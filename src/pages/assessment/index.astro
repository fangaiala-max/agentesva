---
import AssessmentSummary from '../../components/shared/AssessmentSummary.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { trail as buildTrail } from '../../data/breadcrumbs';

const trail = buildTrail({ name: 'Automation assessment', url: '/assessment' });
---

<BaseLayout
  title="Free automation assessment | AgentesVA"
  description="Find the right first process to automate and receive a practical next step for your business."
>
  <SiteHeader />

  <main id="main-content" class="diagnostic-shell" data-diagnostic-root>
    <Breadcrumb trail={trail} />

    <header class="diagnostic-intro">
      <span class="eyebrow">Free assessment · About 3 minutes · 8 questions</span>
      <h1>Find your first worthwhile workflow.</h1>
      <p>Answer eight questions about your business. Get a practical priority and a sensible next step, based on the information you provide.</p>
      <div class="privacy-note">Your answers are processed in this browser first. They are sent only when you request follow-up and accept the privacy policy.</div>
    </header>

    <section class="diagnostic-card" aria-labelledby="diagnostic-title">
      <div class="progress-wrap">
        <div class="progress-copy">
          <span id="diagnostic-title">Assessment</span>
          <span><strong data-step-current>1</strong> of <span data-step-total>8</span></span>
        </div>
        <div class="progress-track" role="progressbar" aria-valuemin="1" aria-valuemax="8" aria-valuenow="1" data-progress>
          <span data-progress-bar></span>
        </div>
      </div>

      <p class="form-error" role="alert" hidden data-diagnostic-error></p>

      <form data-diagnostic-form novalidate>
        <fieldset data-step data-step-id="business_goal">
          <legend>What would you like to improve first?</legend>
          <p class="step-help">Choose the closest option. You can add context later.</p>
          <div class="options">
            <label><input type="radio" name="goal" value="customer_service" required /> Respond to customers more effectively</label>
            <label><input type="radio" name="goal" value="sales" /> Capture and follow up on sales opportunities</label>
            <label><input type="radio" name="goal" value="operations" /> Reduce administrative work</label>
            <label><input type="radio" name="goal" value="marketing" /> Create and distribute content</label>
            <label><input type="radio" name="goal" value="exploring" /> I am still exploring</label>
          </div>
        </fieldset>

        <fieldset data-step data-step-id="team_size" hidden>
          <legend>How many people work in the business?</legend>
          <div class="options">
            <label><input type="radio" name="teamSize" value="solo" required /> Just me</label>
            <label><input type="radio" name="teamSize" value="2_5" /> 2–5 people</label>
            <label><input type="radio" name="teamSize" value="6_20" /> 6–20 people</label>
            <label><input type="radio" name="teamSize" value="21_plus" /> More than 20</label>
          </div>
        </fieldset>

        <fieldset data-step data-step-id="business_type" hidden>
          <legend>What kind of business do you run?</legend>
          <p class="step-help">A short description helps us understand the process.</p>
          <label class="text-label" for="business-type">Business type</label>
          <input id="business-type" name="businessType" type="text" minlength="3" maxlength="80" required placeholder="For example: agency, clinic, online shop…" />
        </fieldset>

        <fieldset data-step data-step-id="process" hidden>
          <legend>Which repetitive task would you like to improve?</legend>
          <p class="step-help">Describe what happens, who does it, and where it starts and ends.</p>
          <label class="text-label" for="process">Current process</label>
          <textarea id="process" name="process" minlength="12" maxlength="500" required placeholder="For example: we manually copy each form submission to a spreadsheet, then send a follow-up…"></textarea>
          <div class="options options--compact">
            <label><input type="radio" name="currentTools" value="some" required /> We already use a tool for this process</label>
            <label><input type="radio" name="currentTools" value="none" /> We do this without dedicated tools</label>
          </div>
        </fieldset>

        <fieldset data-step data-step-id="frequency" hidden>
          <legend>How often does it happen?</legend>
          <div class="options">
            <label><input type="radio" name="frequency" value="sporadic" required /> A few times a year</label>
            <label><input type="radio" name="frequency" value="monthly" /> Several times a month</label>
            <label><input type="radio" name="frequency" value="weekly" /> Every week</label>
            <label><input type="radio" name="frequency" value="daily" /> Every day</label>
            <label><input type="radio" name="frequency" value="high_volume" /> Many times a day</label>
          </div>
        </fieldset>

        <fieldset data-step data-step-id="budget" hidden>
          <legend>What investment range are you considering?</legend>
          <p class="step-help">This is not a binding quote. It helps us recommend a next step that fits.</p>
          <div class="options">
            <label><input type="radio" name="budget" value="exploring" required /> I do not know yet</label>
            <label><input type="radio" name="budget" value="under_300" /> Under €300</label>
            <label><input type="radio" name="budget" value="300_1500" /> €300–€1,499</label>
            <label><input type="radio" name="budget" value="1500_3000" /> €1,500–€2,999</label>
            <label><input type="radio" name="budget" value="3000_5000" /> €3,000–€5,000</label>
            <label><input type="radio" name="budget" value="more_5000" /> More than €5,000</label>
          </div>
        </fieldset>

        <fieldset data-step data-step-id="timeline" hidden>
          <legend>When would you like to start?</legend>
          <div class="options">
            <label><input type="radio" name="timeline" value="now" required /> As soon as possible</label>
            <label><input type="radio" name="timeline" value="one_month" /> In the next month</label>
            <label><input type="radio" name="timeline" value="three_months" /> In the next three months</label>
            <label><input type="radio" name="timeline" value="later" /> Later</label>
          </div>
        </fieldset>

        <fieldset data-step data-step-id="risk" hidden>
          <legend>Does the process involve any of these situations?</legend>
          <div class="options">
            <label><input type="radio" name="risk" value="standard" required /> None of the following</label>
            <label><input type="radio" name="risk" value="sensitive_data" /> Particularly sensitive data</label>
            <label><input type="radio" name="risk" value="high_impact_decisions" /> Medical, legal, financial, or employment decisions</label>
            <label><input type="radio" name="risk" value="unsafe_request" /> Bulk messaging, impersonation, or actions without consent</label>
          </div>
        </fieldset>

        <div class="form-actions">
          <button type="button" class="button-secondary" data-back hidden>Back</button>
          <button type="button" class="button-primary shimmer" data-next>Next</button>
          <button type="submit" class="button-primary shimmer" data-finish hidden>See my recommendation</button>
        </div>
      </form>

      <div class="diagnostic-result" data-diagnostic-result hidden tabindex="-1">
        <span class="eyebrow">Your next step</span>
        <div data-result="qualified_call" hidden>
          <h2>Your process looks ready for an implementation discussion.</h2>
          <p>The frequency, timing, and investment range suggest it is worth reviewing the workflow and checking feasibility.</p>
          <a class="button-primary booking-cta" data-booking-link href="https://calendly.com/fangaiala/auditoria-gratis-agentesva-30-min" target="_blank" rel="noopener noreferrer">Book a 30-minute call</a>
        </div>
        <div data-result="paid_workshop" hidden>
          <h2>Define the scope first.</h2>
          <p>There is a plausible opportunity. A scope workshop would help clarify the process before choosing tools.</p>
        </div>
        <div data-result="self_serve_resources" hidden>
          <h2>Make the opportunity more concrete.</h2>
          <p>Examples and practical resources are likely to be more useful right now than a custom implementation.</p>
        </div>
        <div data-result="manual_review" hidden>
          <h2>This case needs human review.</h2>
          <p>The data or decisions involved call for a review of controls and oversight before recommending automation.</p>
        </div>
        <div class="result-summary" aria-label="Recommendation summary">
          <div><span>Priority</span><strong data-result-priority></strong></div>
          <div><span>Estimated complexity</span><strong data-result-complexity></strong></div>
        </div>
        <h3 class="result-subtitle">Three opportunities to explore</h3>
        <ul data-result-opportunities></ul>
        <h3 class="result-subtitle">Why this next step fits</h3>
        <ul data-result-reasons></ul>
        <a class="button-primary result-next-step" data-result-next-step href="#enviar-diagnostico"></a>
        <AssessmentSummary/><form id="enviar-diagnostico" class="contact-form" data-diagnostic-contact novalidate>
          <h3>Request a follow-up for your business</h3>
          <p>We will reply within one business day with a next step, even if hiring us is not the right answer. You will not be added to the newsletter.</p>
          <div class="contact-grid">
            <label>Name
              <input type="text" name="name" minlength="2" maxlength="100" autocomplete="name" required />
            </label>
            <label>Email
              <input type="email" name="email" maxlength="254" autocomplete="email" required />
            </label>
            <label>Company <span class="optional">Optional</span>
              <input type="text" name="organizationName" maxlength="120" autocomplete="organization" />
            </label>
            <label>Your role <span class="optional">Optional</span>
              <input type="text" name="role" maxlength="100" autocomplete="organization-title" />
            </label>
          </div>
          <div class="honeypot" aria-hidden="true">
            <label>Leave this field empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <label class="consent-row">
            <input type="checkbox" name="consent" required />
            <span>I agree that AgentesVA may process my answers and contact details to review the assessment and respond to my request, as described in the <a href="/privacy/" target="_blank" rel="noopener noreferrer">privacy policy <span class="visually-hidden">(opens in a new tab)</span></a>.</span>
          </label>
          <p class="form-error" role="alert" hidden data-contact-error></p>
          <div class="result-actions">
            <button type="submit" class="button-primary" data-contact-submit>Send my assessment</button>
            <button type="button" class="button-secondary" data-restart>Start again</button>
          </div>
        </form>
        <div class="contact-success" data-contact-success hidden role="status" tabindex="-1">
          <h3>Assessment received</h3>
          <p>The AgentesVA team will reply by email within one business day with a practical recommendation, even if hiring us is not the right answer.</p>
          <a href="mailto:hola@agentesva.com" class="button-secondary">Need to add something? Email us</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .diagnostic-shell { max-width: 900px; margin: 0 auto; padding: 40px 32px 80px; }
  .diagnostic-intro { max-width: 720px; margin: 22px auto 30px; text-align: center; }
  .eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  h1 { font-family:var(--display); font-weight:650; font-size:clamp(38px,6vw,62px); line-height:.96; letter-spacing:-.06em; text-transform:uppercase; color:#fff; margin:16px 0 0; text-wrap:balance; }
  .diagnostic-intro > p { max-width: 650px; margin: 18px auto 0; font-size: 17px; line-height: 1.65; color: var(--fg-3); }
  .privacy-note { margin: 18px auto 0; max-width: 620px; padding: 11px 14px; border: 1px solid var(--line); background: var(--panel-3); color: var(--fg-4); font-size: 12.5px; line-height: 1.5; }
  .diagnostic-card { position:relative; overflow:hidden; background:linear-gradient(145deg,color-mix(in srgb,var(--accent) 7%,var(--panel)),var(--panel)); border:1px solid var(--line-2); border-radius:0; padding:clamp(22px,5vw,42px); box-shadow:18px 18px 0 rgba(41,71,255,.16),0 24px 70px rgba(0,0,0,.28); }
  .progress-copy { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-4); }
  .progress-track { height: 5px; margin-top: 10px; overflow: hidden; background: var(--bg); border-radius: 10px; }
  .progress-track span { display: block; height: 100%; width: 12.5%; background: var(--accent); transition: width .25s ease; }
  fieldset { border: 0; padding: 0; margin: 34px 0 0; min-width: 0; }
  legend { font-family: var(--sans); font-weight: 700; font-size: clamp(22px, 4vw, 30px); line-height: 1.15; letter-spacing: -.025em; color: #fff; padding: 0; }
  .step-help { margin: 9px 0 0; color: var(--fg-3); line-height: 1.55; }
  .text-label { display: block; margin-top: 24px; font-family: var(--mono); color: var(--fg-3); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
  input[type='text'], input[type='email'], textarea { width: 100%; box-sizing: border-box; margin-top: 8px; border: 1px solid var(--line-2); background: var(--panel-3); color: #fff; border-radius: 4px; padding: 14px 16px; font: 15px/1.5 var(--sans); }
  textarea { min-height: 130px; resize: vertical; }
  .options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 24px; }
  .options--compact { grid-template-columns: 1fr; margin-top: 14px; }
  .options label { display: flex; align-items: flex-start; gap: 11px; padding: 15px 16px; border: 1px solid var(--line-2); border-radius: 8px; background: var(--panel-3); color: var(--fg-2); cursor: pointer; line-height: 1.4; transition: transform .22s, border-color .22s, background .22s, box-shadow .22s; }
  .options label:hover { transform: translateY(-2px); border-color: var(--line-3); box-shadow: 0 10px 24px rgba(0,0,0,.12); }
  .options label:has(input:focus-visible) { outline: 3px solid color-mix(in srgb, var(--accent) 60%, white); outline-offset: 3px; }
  .options label:has(input:checked) { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--panel-3)); color: #fff; }
  .options input { margin-top: 3px; accent-color: var(--accent); }
  .form-actions, .result-actions { display: flex; justify-content: space-between; gap: 12px; margin-top: 30px; flex-wrap: wrap; }
  .button-primary, .button-secondary { min-height: 46px; display: inline-flex; align-items: center; justify-content: center; padding: 11px 20px; border-radius: 5px; font: 600 14px var(--sans); text-decoration: none; cursor: pointer; transition: transform .22s, box-shadow .22s, border-color .22s; }
  .button-primary:hover, .button-secondary:hover { transform: translateY(-2px); }
  .button-primary:focus-visible, .button-secondary:focus-visible, input:focus-visible, textarea:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent) 65%, white); outline-offset: 3px; }
  .button-primary { margin-left: auto; border: 1px solid var(--accent); background: var(--accent); color: var(--bg); }
  .button-secondary { border: 1px solid var(--line-2); background: transparent; color: var(--fg-2); }
  .form-error { margin: 20px 0 -14px; padding: 10px 13px; border-left: 3px solid #ff6b6b; color: #ffb0b0; background: rgba(255,107,107,.08); }
  .diagnostic-result { margin-top: 28px; scroll-margin-top: 140px; }
  .diagnostic-result h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 5vw, 40px); line-height: 1.08; color: #fff; margin: 14px 0 0; }
  .diagnostic-result p, .diagnostic-result li { color: var(--fg-3); line-height: 1.6; }
  .diagnostic-result ul { padding-left: 20px; margin: 20px 0 0; }
  .result-summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 24px; }
  .result-summary > div { padding: 15px 16px; border: 1px solid var(--line); background: var(--panel-3); }
  .result-summary span { display: block; color: var(--fg-4); font: 10px var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .result-summary strong { display: block; margin-top: 6px; color: #fff; font-size: 17px; }
  .result-subtitle { margin: 26px 0 0; color: #fff; font: 700 16px var(--sans); }
  .result-next-step { display: inline-flex; margin: 24px 0 0; }
  .contact-form { margin-top: 28px; padding-top: 26px; border-top: 1px solid var(--line); }
  .contact-form h3, .contact-success h3 { color: #fff; font: 700 19px var(--sans); margin: 0; }
  .contact-form > p { margin: 8px 0 0; font-size: 14px; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 18px; }
  .contact-grid label { color: var(--fg-3); font: 11px var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .optional { color: var(--fg-5); font-size: 9px; }
  .booking-cta { margin: 18px 0 2px; width: fit-content; }
  .consent-row { display: flex; align-items: flex-start; gap: 10px; margin-top: 16px; color: var(--fg-4); font-size: 12.5px; line-height: 1.5; }
  .consent-row input { margin-top: 3px; flex: none; accent-color: var(--accent); }
  .consent-row a { color: var(--accent); }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .contact-success { margin-top: 28px; padding: 20px; border: 1px solid var(--green); background: color-mix(in srgb, var(--green) 7%, var(--panel-3)); }
  .contact-success .button-secondary { margin-top: 12px; }
  fieldset:not([hidden]), .diagnostic-result:not([hidden]) { animation: diagnostic-enter .35s cubic-bezier(.22,.61,.36,1) both; }
  @keyframes diagnostic-enter { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) { .options label, .button-primary, .button-secondary { transition: none; } .options label:hover, .button-primary:hover, .button-secondary:hover { transform: none; } fieldset:not([hidden]), .diagnostic-result:not([hidden]) { animation: none; } }
  @media (max-width: 640px) {
    .diagnostic-shell { padding: 28px 20px 60px; }
    .diagnostic-card { padding: 22px 18px; }
    .options { grid-template-columns: 1fr; }
    .result-summary { grid-template-columns: 1fr; }
    .contact-grid { grid-template-columns: 1fr; }
    .form-actions > *, .result-actions > * { width: 100%; margin-left: 0; }
  }
</style>

<script>
  import { initDiagnostic } from '../../scripts/diagnostico';
  document.addEventListener('astro:page-load', () => initDiagnostic());
</script>
